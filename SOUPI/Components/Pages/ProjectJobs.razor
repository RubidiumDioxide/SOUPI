@page "/projectjobs/{projectId:guid}" 
@rendermode InteractiveServer 
@inject IProjectRequestHandler projectRequestHandler
@inject IJobRequestHandler jobRequestHandler
@inject IJobSequenceRequestHandler jobSequenceRequestHandler
@inject ITeamMemberRequestHandler teamMemberRequestHandler
@inject IGithubRequestHandler githubRequestHandler
@inject IDialogService DialogService


<PageTitle>Задачи проекта</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8" Gutters="false">
    @if(error != null)
    {
        <MudAlert Severity=severity>@error</MudAlert>
    }
    else
    {
        @if (User == null || GithubUser == null || project == null || jobs == null || ganttJobs == null ||teamMembers == null)
        {
            <MudText Align="Align.Center">Loading... </MudText>
        }
        else
        {
            @if (!teamMembers.Select(tm => tm.UserId).Contains(User.Id))
            {
                <UnauthorizedPlaceholder />
            }
            else
            {
                <div class="d-flex justify-center ma-4">
                    <MudButton OnClick="OpenDialog" Variant="Variant.Filled" Color="Color.Primary">
                        Добавить задачу
                    </MudButton>
                </div>

                if(ganttJobs.Count() == 0)
                {
                    <MudAlert Severity=Severity.Warning>Здесь пока ничего нет :(</MudAlert> 
                }
                else
                {    
                    <MudPaper Elevation="2" Class="ma-0 pa-0" Style="overflow:hidden; position:relative;">
                        <MudDrawerContainer>
                            <MudDrawer @bind-Open=@isEditDrawerOpen Elevation="4" Variant=DrawerVariant.Persistent Width="700px">
                                <MudContainer>
                                    @if (selectedJob == null)
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                            Нажмите на задачу на диаграмме Ганта, чтобы открыть ее в редакторе.
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 mt-4">
                                      
                                            <MudText Typo="Typo.h6">Задача @selectedJob.Title</MudText>
                             
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Color="Color.Default"
                                                           OnClick="@(() => isEditDrawerOpen = false)" />
                                        </MudStack>
                                                         
                                        <MudExpansionPanels>
                                            <MudExpansionPanel Text="Редактирование свойств " Expanded="true">
                                                <EditJobForm @bind-Job=@selectedJob Project=@project SelectedJobUpdated="JobsUpdated" />
                                            </MudExpansionPanel>

                                            <MudExpansionPanel Text="Редактирование связей " Expanded="false">
                                                <JobSequencesEditor Job="selectedJob" Project="project" JobSequences="selectedJobSequences" />
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                </MudContainer>
                            </MudDrawer>
                               
                            <div class="pa-2" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                               <GanttChart @ref=ganttChart GanttJobs=@ganttJobs OnEditMenuTriggered="OnEditMenuTriggered"/>
                            </div>
                        </MudDrawerContainer>
                    </MudPaper>
                }
            }
        }
    }
</MudContainer>

<MudMenu @ref="jobMenu" Style=@jobMenuStyle>
    <MudMenuItem OnClick="SelectJob">Редактировать</MudMenuItem>
    <MudMenuItem>Удалить</MudMenuItem>
</MudMenu>


    @code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GithubUser? GithubUser { get; set; }

    [Parameter]
    public Guid projectId { get; set; }

    private ProjectDto? project { get; set; } 
    private IEnumerable<JobDto>? jobs { get; set; } 
    private IEnumerable<JobSequenceDisplayDto>? jobSequences { get; set; } 
    private IEnumerable<TeamMemberDisplayDto>? teamMembers { get; set; }  
    private IEnumerable<GanttJobDto>? ganttJobs { get; set; }
    private Guid? selectedJobId { get; set; }
    private JobDto? selectedJob { get; set; }
    private IEnumerable<JobSequenceDisplayDto>? selectedJobSequences { get; set; }

    private MudMenu jobMenu { get; set; }
    private string jobMenuStyle { get; set; }
    private GanttChart ganttChart { get; set; }

    private bool isEditDrawerOpen { get; set; } = false; 

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null && GithubUser != null)
        {
            try
            {
                await LoadProject();
                await LoadJobs(); 
                await LoadJobSequences(); 
                await LoadTeamMembers(); 
            }
            catch (SoupiException ex)
            {
                error = ex.Message;
                severity = Severity.Error;
            }
            catch (Exception ex)
            {
                error = "Произошла непредвиденная ошибка ";
                severity = Severity.Error;
            }
        }
    }

    private async Task LoadProject()
    {
        project = await projectRequestHandler.GetById(projectId);

        StateHasChanged();
    }

    private async Task LoadJobs()
    {
        jobs = await jobRequestHandler.GetByProjectId(projectId);

        ganttJobs = jobs.Select(j => new GanttJobDto(j)); 

        StateHasChanged();
    }

    private async Task LoadJobSequences()
    {
        jobSequences = await jobSequenceRequestHandler.GetByProjectId(projectId);

        StateHasChanged();
    }

    private async Task LoadTeamMembers()
    {
        teamMembers = await teamMemberRequestHandler.GetByProjectId(projectId);

        StateHasChanged();
    } 

    private async Task OnEditMenuTriggered((Guid jobId, MouseEventArgs e) data)
    {
        jobMenuStyle = $"position: fixed; left: {data.e.ClientX}px; top: {data.e.ClientY}px;"; 

        selectedJobId = data.jobId; 

        await jobMenu.ToggleMenuAsync(data.e);
    }

    private async Task SelectJob()
    {
        if (jobs != null && selectedJobId != null && jobSequences != null)
        {
            selectedJob = jobs.FirstOrDefault(j => j.Id == selectedJobId);
            selectedJobSequences = jobSequences
                .Where(js => jobs.Select(j => j.Id).Contains(js.FirstJobId)
                        || jobs.Select(j => j.Id).Contains(js.SecondJobId));
        }

        isEditDrawerOpen = true; 
    }

    private async Task JobsUpdated()
    {
        await LoadJobs(); 
    }

    private async Task OpenDialog()
    {
        var parameters = new DialogParameters<NewJobForm>
        {
            { x => x.User, User }, 
            { x => x.Project, project }, 
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<NewJobForm>("Новая задача", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await JobsUpdated(); 
        }
    }
}