@page "/gantt/{projectId:guid}/{parentJobId:guid?}"
@rendermode InteractiveServer 
@inject IProjectRequestHandler projectRequestHandler
@inject IJobRequestHandler jobRequestHandler
@inject IActivityRequestHandler activityRequestHandler
@inject IAssignmentRequestHandler assignmentRequestHandler
@inject IJobSequenceRequestHandler jobSequenceRequestHandler
@inject ITeamMemberRequestHandler teamMemberRequestHandler
@inject IGitHubRequestHandler gitHubRequestHandler
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager 
@attribute [Authorize]


<PageTitle>Задачи проекта</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="" Style="height:100%; " Gutters="false">
    @if(error != null)
    {
        <MudAlert Severity=severity>@error</MudAlert>
    }
    else
    {
        @if (User == null || GitHubUser == null || project == null || projectJobs == null || currentLevelJobs == null || ganttJobs == null || jobAssignments == null || teamMember == null || teamMembers == null || subservientTeamMembers == null || teamMemberGitHubUsers == null || (parentJobId != null && parentJob == null))
        {
            <LoadingPlaceholder /> 
        }
        else 
        {
            @if (!isTeamMember)
            {
                <UnauthorizedPlaceholder />
            }
            else
            {
                <MudPaper Elevation="2" Class="ma-0 pa-0" Style="height:100%; overflow:hidden; position:relative;">
                    <MudDrawerContainer Style="height:100%;" Class="pa-0 ma-0" >
                        <MudDrawer @bind-Open=@isEditDrawerOpen Elevation="4" Variant=DrawerVariant.Persistent Width="600px">
                            <MudContainer Gutters="false">
                                @if (selectedJob == null)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                        Нажмите на задачу на диаграмме Ганта, чтобы открыть ее в редакторе.
                                    </MudAlert>
                                }
                                else {
                                    <MudStack Row="true"
                                              Class="ma-4"
                                              Justify="Justify.SpaceBetween" 
                                              AlignItems="AlignItems.Center">
                                        <MudStack Row="true" 
                                                  AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.h6">Задача @selectedJob.Title</MudText>
            
                                            <MudChip T="string"
                                                     Color="@selectedJob.Status.GetStatusColor()"
                                                     Variant="Variant.Filled"
                                                     Size="Size.Small"
                                                     Class="mt-1">
                                                @selectedJob.Status.TranslateStatus()
                                            </MudChip>
                                        </MudStack>   

                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                           Color="Color.Success"
                                                           Href="@($"/job/{selectedJob.Id}")" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Color="Color.Default"
                                                           OnClick="@(() => isEditDrawerOpen = false)" />
                                        </MudStack>
                                    </MudStack>
                             
                                    <MudTabs ApplyEffectsToContainer="true" 
                                             TabPanelsClass="pa-2 ma-0">
                                        @* general properties *@
                                        <MudTabPanel Text="Общее ">
                                            <EditJobForm Job=@selectedJob
                                                         Project=@project
                                                         SelectedJobUpdated="JobsUpdated"
                                                         ProjectJobs="projectJobs" 
                                                         IsContentEditable="@(isCreator)"
                                                         IsProgressEditable="@(isCreator || isAssigneeForSelectedJob)" 
                                                         IsChildJob="@(selectedJob.ParentJobId != null)"
                                                         ParentJob="@(projectJobs.FirstOrDefault(j => j.Id == selectedJob.ParentJobId))"/>
                                        </MudTabPanel>

                                        @* links & dependencies *@
                                        @if (isCreator)
                                        {
                                            <MudTabPanel Text="Связи ">
                                                <JobLinksEditor Job="selectedJob"
                                                                Project="project"
                                                                ProjectJobs="projectJobs"
                                                                CurrentLevelJobs="currentLevelJobs"
                                                                SelectedJobUpdated="JobsUpdated" />
                                            </MudTabPanel>   
                                        }
                                        
                                        @* assignments *@
                                        <MudTabPanel Text="Исполнители "> 
                                            <AssignmentsEditor Job="@selectedJob" 
                                                               Assignments="@jobAssignments[selectedJobId!.Value]"
                                                               SubservientTeamMembers="@subservientTeamMembers"
                                                               TeamMemberGitHubUsers="@teamMemberGitHubUsers" 
                                                               OnAssignmentsUpdated="AssignmentsUpdated"/>
                                        </MudTabPanel> 
                                    </MudTabs>
                                }
                            </MudContainer>
                        </MudDrawer>
                               
                        <div class="pa-2" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                            <GanttChart @ref=ganttChart 
                                        Project="@project"
                                        GanttJobs="@ganttJobs" 
                                        OnRightClick="OnRightClick"
                                        OnAddButtonClicked="@(() => OpenAddDialog(parentJob?.Id))"
                                        OnSaveButtonClicked="SaveChangesToJobs" 
                                        OnGoOneLevelUpButtonClicked="GoOneLevelUp"
                                        OnGoToLevelZeroButtonClicked="GoToLevelZero"
                                        IsReadonly="@(!isCreator)"/>
                        </div>
                    </MudDrawerContainer>
                </MudPaper>
            }
        }
    }
</MudContainer>

<MudMenu @ref="jobMenu" Style=@jobMenuStyle @bind-Open="isMenuOpen" >
    <MudMenuItem OnClick="SelectJob">Открыть в редакторе</MudMenuItem> 
    
    @if (isCreator)
    {
        <MudMenuItem OnClick="DeleteJob">Удалить</MudMenuItem>

        if (clickedJob != null && clickedJob.HasChildren)
        {
            <MudMenuItem OnClick="GoToChildren">Перейти к подзадачам</MudMenuItem>
        }

        <MudMenuItem OnClick="@(() => OpenAddDialog(selectedJobId))">Создать новую подзадачу</MudMenuItem>
    }
</MudMenu>


    @code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GitHubUserDto? GitHubUser { get; set; }

    [Parameter]
    public Guid projectId { get; set; }
    [Parameter]
    public Guid? parentJobId { get; set; }

    private ProjectDisplayDto? project { get; set; } 
    private IEnumerable<JobDto>? projectJobs { get; set; } 
    private IEnumerable<JobDto>? currentLevelJobs { get; set; }
    private ILookup<Guid, AssignmentDisplayDto>? jobAssignments { get; set; }
    private IEnumerable<TeamMemberDisplayDto>? teamMembers { get; set; } 
    private TeamMemberDisplayDto? teamMember { get; set; }
    private IDictionary<string, GitHubUserDto>? teamMemberGitHubUsers { get; set; } 
    private IEnumerable<TeamMemberDisplayDto>? subservientTeamMembers { get; set; }
    private IEnumerable<GanttJobDto>? ganttJobs { get; set; } 
    private Guid? selectedJobId { get; set; } 
    private Guid? clickedJobId { get; set; } 
    private JobDto? selectedJob { get; set; } 
    private JobDto? clickedJob { get; set; }
    private JobDto? parentJob { get; set; } 

    private MudMenu jobMenu { get; set; } 
    private string jobMenuStyle { get; set; } 
    private bool isMenuOpen { get; set; } 
    private GanttChart ganttChart { get; set; }

    private bool isEditDrawerOpen { get; set; } = false; 

    private bool isCreator { get; set; } = false; 
    private bool isTeamMember { get; set; } = false; 
    private bool isAssigneeForSelectedJob { get; set; } = false; 

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null && GitHubUser != null)
        {
            try
            {
                await LoadProject();
                await LoadJobs();  
                await LoadJobAssignments();  
                await LoadTeamMembers();               
                await LoadTeamMemberGithubUsers(); 

                isCreator = (project!.CreatorId == User.Id); 
                isTeamMember = teamMembers!.Select(tm => tm.UserId).Contains(User.Id); 
            }
            catch (SoupiException ex)
            {
                error = ex.Message;
                severity = Severity.Error;
            }
            catch (Exception ex)
            {
                error = "Произошла непредвиденная ошибка ";
                severity = Severity.Error;
            }

            StateHasChanged();
        }
    }

    private async Task LoadProject()
    {
        project = await projectRequestHandler.GetById(projectId);
    }

    private async Task LoadJobs()
    {
        projectJobs = await jobRequestHandler.GetByProjectId(projectId);
        currentLevelJobs = await jobRequestHandler.GetByProjectIdParentId(projectId, parentJobId); 

        if(currentLevelJobs.Count() != 0)
        {
            selectedJob = currentLevelJobs.First(); 
        }
        else
        {
            selectedJob = null; 
        }

        if(parentJobId != null)
        {
            parentJob = projectJobs.FirstOrDefault(j => j.Id == parentJobId.Value); 
        }
        else
        {
            parentJob = null; 
        }

        ganttJobs = currentLevelJobs.Select(j => new GanttJobDto(j)); 
    }

    private async Task LoadJobAssignments()
    {
        var assignments = await assignmentRequestHandler.GetByProjectId(projectId);

        jobAssignments = assignments.ToLookup(a => a.JobId);
    }

    private async Task LoadTeamMembers()
    {
        teamMembers = await teamMemberRequestHandler.GetByProjectId(projectId); 

        teamMember = teamMembers.FirstOrDefault(tm => tm.UserId == User!.Id); 

        subservientTeamMembers = GetAllSubservients(teamMember!, teamMembers); 
    } 

    private async Task LoadTeamMemberGithubUsers()
    {
        var githubUsers = await gitHubRequestHandler.GetUsersByLogins(teamMembers!.Select(tm => tm.UserLogin));

        teamMemberGitHubUsers = githubUsers.ToDictionary(gu => gu.Login);
    }

    private async Task OnRightClick((Guid jobId, MouseEventArgs e) data)
    {
        if (isMenuOpen)
        {
            await jobMenu.CloseMenuAsync(); 
        }

        jobMenuStyle = $"position: fixed; left: {data.e.ClientX}px; top: {data.e.ClientY}px;";

        clickedJobId = data.jobId; 

        clickedJob = currentLevelJobs!.FirstOrDefault(j => j.Id == clickedJobId);

        await jobMenu.OpenMenuAsync(data.e); 
    }

    private async Task SelectJob()
    {
        selectedJobId = clickedJobId; 

        if (projectJobs != null && selectedJobId != null)
        {
            selectedJob = projectJobs.FirstOrDefault(j => j.Id == selectedJobId);
        }

        isAssigneeForSelectedJob = (selectedJobId != null && jobAssignments != null && teamMember != null) ? jobAssignments[selectedJobId.Value].Any(a => a.TeamMemberId == teamMember.Id) : false;

        isEditDrawerOpen = true; 
    }

    private async Task DeleteJob()
    {
        if (projectJobs != null && clickedJobId != null)
        {
            clickedJob = projectJobs.FirstOrDefault(j => j.Id == clickedJobId);

            if (clickedJob != null)
            {
                try
                {
                    await jobRequestHandler.Delete(clickedJobId.Value);

                    await LoadJobs(); 

                    if(currentLevelJobs.Count() == 0 && parentJob != null)
                    {
                        await GoOneLevelUp(); 
                    }

                    Snackbar.Add("Задача успешно удалена", Severity.Success);
                }
                catch (SoupiException ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                }
                catch (Exception)
                {
                    Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
                }
            } 
        }
    }

    public async Task GoToChildren()
    {
        if(project != null && clickedJobId != null && clickedJobId != parentJobId)
        {
            NavigationManager.NavigateTo($"gantt/{project.Id}/{clickedJobId}");
        }
    }

    public async Task GoOneLevelUp()
    {
        if (project != null && parentJob != null)
        {
            NavigationManager.NavigateTo($"gantt/{project.Id}/{parentJob.ParentJobId}");
        }
    }

    public async Task GoToLevelZero()
    {
        if (project != null && parentJobId != null)
        {
            NavigationManager.NavigateTo($"gantt/{project.Id}");
        }
    }

    private async Task JobsUpdated()
    {
        await LoadJobs(); 

        StateHasChanged(); 
    }

    private async Task AssignmentsUpdated()
    {
        await LoadJobAssignments();

        isAssigneeForSelectedJob = (selectedJobId != null && jobAssignments != null && teamMember != null) ? jobAssignments[selectedJobId.Value].Any(a => a.TeamMemberId == teamMember.Id) : false;

        StateHasChanged();
    }

    private async Task OpenAddDialog(Guid? parentJobId)
    {
        JobDto? parentJob = null; 

        if (parentJobId != null)
        {
            parentJob = projectJobs.FirstOrDefault(j => j.Id == parentJobId);  
        }

        var parameters = new DialogParameters<NewJobForm>
        {
            { x => x.TeamMember, teamMember }, 
            { x => x.Project, project }, 
            { x => x.ProjectJobs, projectJobs }, 
            { x => x.ParentJob, parentJob }, 
            { x => x.IsChildJob, (parentJob == null)? false : true }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<NewJobForm>("Новая задача", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await JobsUpdated(); 
        }
    }

    private async Task SaveChangesToJobs(IEnumerable<GanttJobDto> ganttJobDtos)
    {
        foreach(var gj in ganttJobDtos)
        {
            try
            {
                var existingJob = projectJobs!.FirstOrDefault(j => j.Id == Guid.Parse(gj.id)); 

                if (existingJob == null)
                {
                    throw new Exception();
                }

                var newStartDateTime = DateOnly.Parse(gj.start);
                var newEndDateTime = DateOnly.Parse(gj.end);
                int newDuration = newEndDateTime.DayNumber - newStartDateTime.DayNumber;

                if(existingJob.ParentJobId != null && (newStartDateTime != existingJob.StartDateTime || newEndDateTime != existingJob.EndDateTime)) 
                {
                    var foundParentJob = projectJobs.FirstOrDefault(j => j.Id == existingJob.ParentJobId); 

                    if(newStartDateTime < foundParentJob.StartDateTime
                    || newStartDateTime > foundParentJob.EndDateTime 
                    || newEndDateTime < foundParentJob.StartDateTime
                    || newEndDateTime > foundParentJob.EndDateTime)
                    {
                        throw new SoupiException($"Временные ограничения дочерних задач должны находиться в рамках родительской задачи. Изменения для задачи '{gj.name}' не будут сохранены ");
                    }
                }

                var foundDirectChildren = projectJobs.Where(j => j.ParentJobId == existingJob.Id);

                if(foundDirectChildren.Count() > 0)
                {
                    var earliestDate = foundDirectChildren.Select(cj => cj.StartDateTime).Min(); 
                    var latestDate = foundDirectChildren.Select(cj => cj.EndDateTime).Max(); 
                    int childrenDuration = latestDate.DayNumber - earliestDate.DayNumber;

                    if(childrenDuration > newDuration)
                    {
                        throw new SoupiException($"Временные ограничения дочерних задач должны находиться в рамках родительской задачи. Изменения для задачи '{gj.name}' не будут сохранены "); 
                    }
                }

                if (!existingJob.IsEquivalent(gj))
                {
                    existingJob.StartDateTime = DateOnly.Parse(gj.start);
                    existingJob.EndDateTime = DateOnly.Parse(gj.end); 
                    existingJob.Progress = gj.progress; 

                    await jobRequestHandler.UpdateContent(existingJob); 
                }
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception)
            {
                Snackbar.Add("При сохранении задачи произошла непредвиденная ошибка ", Severity.Error);
            }
        }

        await LoadJobs(); 
        StateHasChanged();
        
        Snackbar.Add("Задачи были успешно сохранены ", Severity.Success); 
    }

    private IEnumerable<TeamMemberDisplayDto> GetAllSubservients(TeamMemberDisplayDto currentTeamMember, IEnumerable<TeamMemberDisplayDto> teamMembers)
    {
        var result = new List<TeamMemberDisplayDto>();
       
        result.Add(currentTeamMember);
        
        var directSubservients = teamMembers!.Where(tm => tm.SupervisorId == currentTeamMember.Id).ToList();

        result.AddRange(directSubservients);

        foreach (var subservient in directSubservients)
        {
            result.AddRange(GetAllSubservients(subservient, teamMembers).Where(tm => !result.Contains(tm)));
        }

        return result;
    }
}