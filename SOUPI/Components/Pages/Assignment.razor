@page "/assignment/{assignmentId:guid}/"
@inject IAssignmentRequestHandler assignmentRequestHandler
@inject IProjectRequestHandler projectRequestHandler
@inject IActivityRequestHandler activityRequestHandler
@inject ITeamMemberRequestHandler teamMemberRequestHandler  
@inject IGitHubRequestHandler gitHubRequestHandler 
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]


<PageTitle>Исполнитель </PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="" Style="height:100%; ">
    @if(error != null)
    {
        <MudAlert Severity=severity>@error</MudAlert>
    }
    else
    {
        @if (User == null || project == null || assignment == null || activities == null || teamMember == null || teamMemberGitHubUser == null)
        {
            <LoadingPlaceholder />
        }
        else
        {  
            @if (!isCreator && !isAssignee)
            {
                <UnauthorizedPlaceholder />
            }
            else
            {
                @if (isAssignee)
                {
                    <MudStack AlignItems="AlignItems.Center">
                        <MudText Align="Align.Center"
                                 Typo="Typo.body2"
                                 Class="mud-text-secondary mt-4">
                            Если к проекту привязан репозиторий GitHub и на нем создан вебхук (создается автоматически в разделе "Настройки" страницы проекта), действия будут добавлять автоматически для кажлого коммита в репозитории, содержащего в тексте комментария к коммиту название задачи в квадратных скобках (например, [задача 1]). Вы также можете добавить действие со ссылкой на коммит вручную - при условии, что коммит существует. Действия без ссылок на коммиты также можно добавить вручную.
                        </MudText>

                        <MudButton onclick="OpenAddDialog"
                                   Color="Color.Success"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Add">
                            Добавить действие
                        </MudButton>
                    </MudStack>
                }

                <AssignmentWithActivities Assignment="assignment"
                                          Project="project"
                                          TeamMember="teamMember"
                                          TeamMemberGitHubUser="teamMemberGitHubUser"
                                          Activities="activities"
                                          ActivitiesCommits="activitiesCommits"
                                          DeleteActivity="OpenDeleteDialog" 
                                          IsDeletable="true"/>
            }
        }
    }
</MudContainer>


    @code {
    [CascadingParameter]
    private UserDto? User { get; set; }

    [Parameter]
    public Guid assignmentId { get; set; }

    private AssignmentDisplayDto? assignment { get; set; } 
    private ProjectDisplayDto? project { get; set; }
    private TeamMemberDisplayDto? teamMember { get; set; }
    private GitHubUserDto? teamMemberGitHubUser { get; set; }
    private IEnumerable<ActivityDisplayDto>? activities { get; set; }
    private IDictionary<Guid, GitHubCommitDto>? activitiesCommits { get; set; } 

    private bool isCreator { get; set; } = false;
    private bool isAssignee { get; set; } = false;

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null)
        {
            try
            {
                await LoadAssignment();
                await LoadProject(); 
                await LoadTeamMember();
                await LoadTeamMemberGithubUser();
                await LoadActivities(); 
                await LoadActivitiesCommits(); 

                isCreator = (project!.CreatorId == User.Id);
                // teamMember is derived from the assignment 
                isAssignee = teamMember!.UserId == User.Id; 
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }

        StateHasChanged();
    }

    private async Task LoadAssignment()
    {
        assignment = await assignmentRequestHandler.GetById(assignmentId);
    }

    private async Task LoadProject()
    {
        project = await projectRequestHandler.GetById(assignment!.ProjectId);
    }

    private async Task LoadActivities()
    {
        activities = await activityRequestHandler.GetByAssignmentId(assignmentId);
    }

    private async Task LoadTeamMember()
    {
        teamMember = await teamMemberRequestHandler.GetById(assignment!.TeamMemberId);
    }

    private async Task LoadTeamMemberGithubUser()
    {
        teamMemberGitHubUser = await gitHubRequestHandler.GetUserByLogin(teamMember!.UserLogin); 
    }

    private async Task LoadActivitiesCommits()
    {
        var commits = new List<GitHubCommitDto>();

        foreach (var activity in activities!)
        {
            if(activity.Commit != null)
            {
                var commit = await gitHubRequestHandler.GetCommitByHash(project!, activity.Commit);     

                commits.Add(commit);
            }
        }

        activitiesCommits = activities
            .Join(
                commits,
                activity => activity.Commit,  // Key from Activity
                commit => commit.Sha,         // Key from Commit 
                (activity, commit) => new { activity.Id, commit } 
            )
            .ToDictionary(x => x.Id, x => x.commit);
    } 

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters<NewActivityForm>
        {
            { x => x.Assignment, assignment }, 
            { x => x.Project, project } 
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<NewActivityForm>("Добавление действия ", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadActivities(); 
            await LoadActivitiesCommits(); 

            StateHasChanged();
        }
    }

    private async Task OpenEditDialog(ActivityDisplayDto updatedActivity)
    {
        var parameters = new DialogParameters<EditActivityForm>
        {
            { x => x.Activity, updatedActivity } 
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<EditActivityForm>("Редактирование действия ", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadActivities();

            StateHasChanged();
        }
    }

    private async Task OpenDeleteDialog(Guid activityId)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.Title, "Удаление действия"},
            { x => x.Message, "Вы действительно хотите удалить это действие? Удаление не затронет содержимое репозитория (например, связанные коммиты) " },
            { x => x.ConfirmationText, "Удалить" },
            { x => x.ConfirmationColor, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("SimpleDialog", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await Delete(activityId);
        }
    }

    private async Task Delete(Guid activityId)
    {
        try
        {
            await activityRequestHandler.Delete(activityId);

            await LoadActivities();

            Snackbar.Add($"Действие успешно удалено ", Severity.Success);

            StateHasChanged();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }
}
