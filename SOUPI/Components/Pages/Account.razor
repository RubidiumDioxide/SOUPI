@page "/"
@inject NavigationManager NavigationManager 
@inject IUserRequestHandler userRequestHandler 
@inject ISnackbar Snackbar 
@attribute [Authorize]


<PageTitle>Мой аккаунт</PageTitle>

<MudContainer Class="pt-14">  
    @if (GithubUser == null || User == null)
    {
        <MudText Align="Align.Center">Loading... </MudText>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                <!-- Profile Picture -->
                <MudAvatar Style="height:150px; width:150px; font-size:2rem" Class="mb-2">
                    <MudImage Src="@GithubUser.AvatarUrl" Alt="Profile picture" />
                </MudAvatar>

                <!-- User Name -->
                <MudText Typo="Typo.h6" Class="text-center">
                    @GithubUser.Name
                    <MudIcon Color="Color.Primary" Icon=@Icons.Custom.Brands.GitHub Size="Size.Small" @onclick="GoToGitHubUserProfile"/>
                </MudText> 
                <MudText Typo="Typo.body2" Class="text-center">@GithubUser.Login</MudText>

                <MudDivider/>

                <!-- User Bio/Description -->
                @if (!string.IsNullOrEmpty(GithubUser.Bio))
                {
                    <MudText Typo="Typo.body2" Class="text-center mt-2" Color="Color.Secondary">
                        @GithubUser.Bio
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GithubUser? GithubUser { get; set; }

    private void GoToGitHubUserProfile()
    {
        NavigationManager.NavigateTo(GithubUser!.HtmlUrl); 
    }
}