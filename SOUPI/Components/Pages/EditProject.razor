@page "/editproject/{projectId:guid}"
@inject NavigationManager NavigationManager
@inject GithubRequestHandler githubRequestHandler 
@inject UserRequestHandler userRequestHandler
@inject ProjectRequestHandler projectRequestHandler 
@inject ImageRequestHandler imageRequestHandler 
@inject ISnackbar Snackbar
@inject IHttpContextAccessor HttpContextAccessor
@using GithubUser = Octokit.User
@using Octokit
@using Project = SOUPIShared.Models.Project
@using SOUPIShared.Exceptions;
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]


<PageTitle>Редактировать проект</PageTitle>

<MudContainer Class="pt-14">
    @if (user == null || project == null)
    {
        <MudText Align="Align.Center">Loading... </MudText>
    }
    else
    {
        <EditForm Model=@project OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudCard Style="max-width: 700px" Class="ma-auto">
                <MudCardHeader>
                    <MudText Typo="Typo.h5" Class="mb-1 ma-auto">Редактирование проекта @project.Name</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value=@project.Name For="@(() => project.Name)" Label="Название проекта" Variant=Variant.Outlined />
                    <MudTextField @bind-Value=@project.Description For="@(() => project.Description)" Label="Описание проекта" Variant=Variant.Outlined Lines="5" />
                    @if (project.GithubRepository == null)
                    {
                        <MudTextField @bind-Value=@project.GithubRepository For="@(() => project.GithubRepository)" Label="Название репозитория на Github" Variant=Variant.Outlined />
                    }

                    <MudFileUpload T="IBrowserFile" Accept=".jpg, .png, .jpeg" OnFilesChanged=@(async (e) => await OnImageChanged(e))>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Image">
                                Обложка (.jpg, .png, .jpeg)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (imagePreviewUrl != null)
                    {
                        <MudImage Src="@imagePreviewUrl" Width="200" Alt="Project Image Preview" Elevation="25" Class="rounded-lg ma-4" />
                    }
                    else if(project.Image != null)
                    {
                        <MudImage Src=@($"uploads/{project.Image}") Width="200" Alt="Project Image Preview" Elevation="25" Class="rounded-lg ma-4" />
                    }
                </MudCardContent>
                <MudCardActions Class="mt-1 ma-auto">
                    <MudButton @ref=submitButton ButtonType=ButtonType.Submit Color="Color.Primary" Variant="Variant.Filled">Сохранить изменения</MudButton>
                    <MudButton onclick="ResetForm" Color="Color.Secondary" Variant="Variant.Filled">Сбросить</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    }
</MudContainer>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    [Parameter]
    public Guid projectId { get; set; }
    private UserDto? user { get; set; }
    private ProjectDto project = new ProjectDto();
    private IBrowserFile? imageFile { get; set; }
    private string? imagePreviewUrl { get; set; }

    private MudButton submitButton;  

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState != null)
        {
            var authState = await authenticationState;

            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await LoadUser();
                await LoadProject(); 

                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private async Task LoadUser()
    {
        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            var githubUserLogin = httpContext.User.FindFirst("urn:github:login").Value;

            if (string.IsNullOrEmpty(githubUserLogin))
            {
                throw new SoupiException("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ");
            }

            user = await userRequestHandler.GetByLogin(githubUserLogin);

            if (user == null)
            {
                throw new SoupiException("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ");
            }
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private async Task LoadProject()
    {
        try
        {
            project = await projectRequestHandler.GetById(projectId);

            StateHasChanged();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private void ResetForm()
    {
        imageFile = null;
        imagePreviewUrl = null;
        project = new ProjectDto();
        StateHasChanged();
    }

    private async Task OnImageChanged(InputFileChangeEventArgs e)
    {
        if (e.File.Size >= 512000)
        {
            Snackbar.Add("Размер изображения превышает допустимый (512000 байт). Изображение не будет сохранено", Severity.Error);
            return;
        }

        imageFile = e.File;
        var compressedImageFile = await e.File.RequestImageFileAsync(e.File.ContentType, 200, 200);

        var buffer = new byte[compressedImageFile.Size];
        await compressedImageFile.OpenReadStream().ReadAsync(buffer);
        imagePreviewUrl = $"data:{compressedImageFile.ContentType};base64,{Convert.ToBase64String(buffer)}";

        StateHasChanged();
    }

    private async Task OnValidSubmit()
    {
        submitButton.Disabled = true;

        try
        {
            if (!string.IsNullOrEmpty(project.GithubRepository))
            {
                var repositories = await githubRequestHandler.GetRepositoriesForCurrent();
                if (!repositories.Select(r => r.Name).Contains(project.GithubRepository))
                {
                    throw new SoupiException("Похоже, у вас нет доступа к этому репозиторию. Проверьте название репозитория ");
                }
            }

            var projects = await projectRequestHandler.GetByUserId(user.Id);
            if (projects.Where(p => p.Id != project.Id).Select(p => p.Name).Contains(project.Name))
            {
                throw new SoupiException("Вы уже создавали проект с таким названием. Названия проектов должны быть уникальными ");
            }

            // try uploading an image & deleting older one 
            if (imageFile != null)
            {
                var oldProjectImage = project.Image; 
                project.Image = await imageRequestHandler.Upload(imageFile, imageFile.Name);
                
                if (oldProjectImage != null)
                {
                    imageRequestHandler.Delete(oldProjectImage);
                }
            }

            project = await projectRequestHandler.Update(project);

            Snackbar.Add("Изменения в проекте были успешно сохранены ", Severity.Success);

            ResetForm();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }

        submitButton.Disabled = false;
    }
}