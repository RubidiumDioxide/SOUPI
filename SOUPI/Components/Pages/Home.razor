@page "/"
@inject NavigationManager NavigationManager 
@inject IHttpContextAccessor HttpContextAccessor 
@inject ISnackbar SnackBar 


<PageTitle>Home</PageTitle>

<MudContainer Class="pt-20">
    <MudStack AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5" Align="Align.Center">Hey there! To use this app, you must first log in using your GitHub account.</MudText>
        <MudText Typo="Typo.body2">All of your projects and progress will be saved under this GitHub account.</MudText>

        <MudButton Href="/Auth/Login" Variant="Variant.Filled" Color="Color.Primary">
            Log In with GitHub 
        </MudButton>
    </MudStack>
</MudContainer>


@code {
    private bool isAuthenticated { get; set; }
    private User user { get; set; } = default!;
    private AuthenticationState? authenticationState { get; set; }

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            var newAuthState = httpContext.User.Identity?.IsAuthenticated ?? false;
            if (newAuthState != isAuthenticated)
            {
                isAuthenticated = newAuthState;
            }
        }

        if(isAuthenticated){
            NavigationManager.NavigateTo("account"); 
        }
    }
}