@page "/myassignments"
@inject IAssignmentRequestHandler assignmentRequestHandler
@inject IJobRequestHandler jobRequestHandler
@inject IProjectRequestHandler projectRequestHandler
@inject ISnackbar Snackbar
@inject IDialogService DialogService


@if (User == null || GitHubUser == null || jobs == null || jobsAssignments == null)
{
    <LoadingPlaceholder />
}
else
{
    <MudContainer Class="pt-14" MaxWidth=MaxWidth.Medium>        
        @if (jobs.Count() == 0)
        {
            <MudAlert Severity="Severity.Info" >
                Вам пока не назначили выполнение задач. Отдыхайте :) 
            </MudAlert>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var job in jobs)
                {
                    <JobAssignmentListElement Job="@job"
                                              Assignment="@jobsAssignments[job.Id]"/>
                }
            </MudStack>
        }
    </MudContainer>
}


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GitHubUserDto? GitHubUser { get; set; }

    public IEnumerable<JobDisplayDto>? jobs { get; set; } 
    public IDictionary<Guid, AssignmentDisplayDto>? jobsAssignments { get; set; } 

    protected override async Task OnParametersSetAsync()
    {
        if (User != null && GitHubUser != null)
        {
            try
            {
                await LoadJobs(); 
                await LoadAssignments(); 
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }

        StateHasChanged();
    }

    private async Task LoadJobs()
    {
        jobs = await jobRequestHandler.GetDisplayByUserId(User!.Id);
    }

    private async Task LoadAssignments()
    {
        var assignments = await assignmentRequestHandler.GetByUserId(User!.Id);

        jobsAssignments = assignments.ToDictionary(a => a.JobId); 
    }
}