@page "/project/{projectId:guid}/"
@inject IJobRequestHandler jobRequestHandler 
@inject IAssignmentRequestHandler assignmentRequestHandler
@inject IProjectRequestHandler projectRequestHandler
@inject IActivityRequestHandler activityRequestHandler
@inject ITeamMemberRequestHandler teamMemberRequestHandler  
@inject IGitHubRequestHandler gitHubRequestHandler 
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]


<PageTitle>Проект @((project != null) ? project.Title : string.Empty)</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="" Style="height:100%; " Gutters="false">
    @if(error != null)
    {
        <MudAlert Severity=severity>@error</MudAlert>
    }
    else
    {
        @if (User == null || project == null || jobs == null || assignments == null || jobAssignments == null || activities == null || teamMembers == null || teamMemberGitHubUsers == null || creatorTeamMember == null || creatorTeamMemberGitHubUser == null)
        {
            <LoadingPlaceholder />
        }
        else
        {
            @if (!isTeamMember)
            {
                <UnauthorizedPlaceholder />       
            }
            else
            {
                <MudTabs ApplyEffectsToContainer="true"
                         TabPanelsClass="pa-2 ma-0"
                         Centered="true">
                    @* general *@
                    <MudTabPanel Text="Общее ">
                        <ProjectDisplay Project="@project"
                                        Creator="@creatorTeamMember"
                                        CreatorGitHubUser="@creatorTeamMemberGitHubUser" />
                    </MudTabPanel>

                    @if (isCreator)
                    {
                        @* team *@
                        <MudTabPanel Text="Команда проекта ">
                            @* TO-DO: REWORK *@
                            <ProjectTeam Project="project"
                                         ProjectUpdated="ProjectUpdated" />
                        </MudTabPanel>
                    }

                    @* jobs *@
                    <MudTabPanel Text="Задачи и исполнители ">
                        <MudContainer MaxWidth="MaxWidth.Medium">
                            <MudText Align="Align.Center"
                                     Typo="Typo.body2"
                                     Class="mud-text-secondary mb-4 mt-4">
                                Эта страница служит для простого просмотра и навигации по задачам и исполнителям. Чтобы редактировать совйства задачи, а также связи между задачами, перейдите на страницу
                                <MudButton Href="@($"/gantt/{projectId}")"
                                           Color="Color.Success"
                                           Size="Size.Small">
                                    Диаграмма Ганта
                                </MudButton>
                                .
                            </MudText>

                            @if (jobs.Count() == 0)
                            {
                                <MudAlert Severity="Severity.Info" Class="ma-4">
                                    У этого проекта пока нет задач
                                </MudAlert>
                            }
                            else
                            {
                                <MudStack Spacing="1">
                                    @foreach (var job in jobs)
                                    {
                                        <JobListElement Job="job"
                                                        Assignments="jobAssignments[job.Id]"
                                                        TeamMemberGitHubUsers="teamMemberGitHubUsers.Values"
                                                        IsEditable="false" />
                                    }
                                </MudStack>
                            }
                        </MudContainer>
                    </MudTabPanel>

                    @* staticstics *@
                    <MudTabPanel Text="Статистика ">
                        <ProjectStatistics Project="project"
                                           Jobs="jobs"
                                           Assignments="assignments"
                                           Activities="activities"
                                           TeamMembers="teamMembers" />
                    </MudTabPanel>

                    @if (isCreator)
                    {
                        @* settings *@
                        <MudTabPanel Text="Настройки ">
                            <ProjectSettings Project="@project"
                                             TeamMembers="@teamMembers"
                                             Creator="@creatorTeamMember"
                                             ProjectUpdated="ProjectUpdated" />
                        </MudTabPanel>
                    }
                </MudTabs>
            }
        }
    }
</MudContainer>


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }

    [Parameter]
    public Guid projectId { get; set; }

    private ProjectDisplayDto? project { get; set; } 
    private IEnumerable<JobDisplayDto>? jobs { get; set; } 
    private IEnumerable<AssignmentDisplayDto>? assignments { get; set; }
    private ILookup<Guid, AssignmentDisplayDto>? jobAssignments { get; set; } 
    private IEnumerable<ActivityDisplayDto>? activities { get; set; }
    private IEnumerable<TeamMemberDisplayDto>? teamMembers { get; set; }
    private IDictionary<Guid, GitHubUserDto>? teamMemberGitHubUsers { get; set; }
    private TeamMemberDisplayDto? creatorTeamMember { get; set; }
    private GitHubUserDto? creatorTeamMemberGitHubUser { get; set; }

    private bool isCreator { get; set; } = false;
    private bool isTeamMember { get; set; } = false;

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null)
        {
            try
            {
                await LoadProject();
                await LoadJobs(); 
                await LoadAssignments();
                await LoadJobAssignments(); 
                await LoadActivities(); 
                await LoadTeamMembers(); 
                await LoadTeamMemberGithubUsers(); 

                isCreator = (project!.CreatorId == User.Id);
                isTeamMember = teamMembers!.Select(tm => tm.UserId).Contains(User.Id);
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }

        StateHasChanged();
    }

    private async Task LoadProject()
    {
        project = await projectRequestHandler.GetById(projectId);
    }

    private async Task LoadJobs()
    {
        jobs = await jobRequestHandler.GetDisplayByProjectId(projectId);
    }

    private async Task LoadAssignments()
    {
        assignments = await assignmentRequestHandler.GetByProjectId(projectId);
    }

    private async Task LoadJobAssignments()
    {
        jobAssignments = assignments.ToLookup(a => a.JobId);
    }

    private async Task LoadActivities()
    {
        activities = await activityRequestHandler.GetByProjectId(projectId); 
    }

    private async Task LoadTeamMembers()
    {
        teamMembers = await teamMemberRequestHandler.GetByProjectId(projectId);

        creatorTeamMember = teamMembers.FirstOrDefault(tm => tm.UserId == project!.CreatorId);
    }

    private async Task LoadTeamMemberGithubUsers()
    {
        var gitHubUsers = await gitHubRequestHandler.GetUsersByLogins(teamMembers!.Select(tm => tm.UserLogin));

        creatorTeamMemberGitHubUser = gitHubUsers.FirstOrDefault(gu => gu.Login == creatorTeamMember!.UserLogin); 

       teamMemberGitHubUsers = teamMembers!.Join(
           gitHubUsers,
           teamMember => teamMember.UserLogin,
           gitHubUser => gitHubUser.Login,
           (teamMember, gitHubUser) => new { teamMember.Id, gitHubUser}
       )
       .ToDictionary(x => x.Id, x => x.gitHubUser); 
    }

    private async Task ProjectUpdated()
    {
        await LoadProject(); 
        await LoadTeamMembers();
        await LoadTeamMemberGithubUsers();
        
        StateHasChanged();
    }
}
