@page "/newproject"
@inject NavigationManager NavigationManager
@inject IGithubRequestHandler githubRequestHandler 
@inject IUserRequestHandler userRequestHandler
@inject IProjectRequestHandler projectRequestHandler
@inject IImageRequestHandler imageRequestHandler
@inject ISnackbar Snackbar
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Authorize] 


<PageTitle>Новый проект</PageTitle>

<MudContainer Class="pt-14">
    @if (user == null || newProject == null)
    {
        <MudText Align="Align.Center">Loading... </MudText>
    }
    else
    {
        <EditForm Model=@newProject OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudCard Style="max-width: 700px" Class="ma-auto">
                <MudCardHeader>
                    <MudText Typo="Typo.h5" Class="mb-1 ma-auto">Создание нового проекта</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value=@newProject.Name For="@(() => newProject.Name)" Label="Название проекта" Variant=Variant.Outlined />
                    <MudTextField @bind-Value=@newProject.Description For="@(() => newProject.Description)" Label="Описание проекта" Variant=Variant.Outlined Lines="5" />
                    <MudTextField @bind-Value=@newProject.GithubRepository For="@(() => newProject.GithubRepository)" Label="Название репозитория на Github" Variant=Variant.Outlined />

                    <MudFileUpload T="IBrowserFile" Accept=".jpg, .png, .jpeg" OnFilesChanged=@(async (e) => await OnImageChanged(e))>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Image">
                                Обложка (.jpg, .png, .jpeg)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (imagePreviewUrl != null)
                    {
                        <MudImage Src="@imagePreviewUrl" Width="200" Alt="Project Image Preview" Elevation="25" Class="rounded-lg ma-4" />
                    }
                </MudCardContent>
                <MudCardActions Class="mt-1 ma-auto">
                    <MudButton @ref=submitButton ButtonType=ButtonType.Submit Color="Color.Primary" Variant="Variant.Filled">Создать</MudButton>
                    <MudButton onclick="ResetForm" Color="Color.Secondary" Variant="Variant.Filled">Сбросить</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    }
</MudContainer>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private UserDto? user { get; set; } 
    private ProjectDto newProject = new ProjectDto(); 
    private IBrowserFile? imageFile { get; set; }
    private string? imagePreviewUrl { get; set; }

    private MudButton submitButton { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState != null)
        {
            var authState = await authenticationState;

            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await LoadUser(); 

                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private async Task LoadUser()
    {
        try
        {   
            var httpContext = HttpContextAccessor.HttpContext;
            var githubUserLogin = httpContext.User.FindFirst("urn:github:login").Value;

            if (string.IsNullOrEmpty(githubUserLogin))
            {
                throw new SoupiException("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ");
            }

            user = await userRequestHandler.GetByLogin(githubUserLogin);

            if (user == null)
            {
                throw new SoupiException("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ");
            }
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private void ResetForm()
    {
        imageFile = null;
        imagePreviewUrl = null; 
        newProject = new ProjectDto();
        StateHasChanged();
    }

    private async Task OnImageChanged(InputFileChangeEventArgs e)
    {
        if (e.File.Size >= 512000)
        {
            Snackbar.Add("Размер изображения превышает допустимый (512000 байт). Изображение не будет сохранено", Severity.Error);
            return; 
        }

        imageFile = e.File; 
        var compressedImageFile = await e.File.RequestImageFileAsync(e.File.ContentType, 200, 200);

        var buffer = new byte[compressedImageFile.Size];
        await compressedImageFile.OpenReadStream().ReadAsync(buffer);
        imagePreviewUrl = $"data:{compressedImageFile.ContentType};base64,{Convert.ToBase64String(buffer)}";

        StateHasChanged();
    }

    private async Task OnValidSubmit()
    {
        submitButton.Disabled = true; 

        newProject.CreatorId = user!.Id; 

        try
        {
            if (!string.IsNullOrEmpty(newProject.GithubRepository))
            {
                var repositories = await githubRequestHandler.GetRepositoriesForCurrentUser();
                if (!repositories.Select(r => r.Name).Contains(newProject.GithubRepository))
                {
                    throw new SoupiException("Похоже, у вас нет доступа к этому репозиторию. Проверьте название репозитория ");
                }
            }

            var projects = await projectRequestHandler.GetByUserId(user.Id); 
            if(projects.Select(p => p.Name).Contains(newProject.Name))
            {
                throw new SoupiException("Вы уже создавали проект с таким названием. Названия проектов должны быть уникальными "); 
            }

            // try uploading an image
            if (imageFile != null)
            {        
                newProject.Image = await imageRequestHandler.Upload(imageFile, imageFile.Name);  
            } 

            newProject = await projectRequestHandler.Create(newProject);  

            Snackbar.Add("Проект успешно создан", Severity.Success); 

            ResetForm(); 
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }

        submitButton.Disabled = false;
    }
}