@page "/job/{jobId:guid}/"
@inject IJobRequestHandler jobRequestHandler 
@inject IAssignmentRequestHandler assignmentRequestHandler
@inject IProjectRequestHandler projectRequestHandler
@inject IActivityRequestHandler activityRequestHandler
@inject ITeamMemberRequestHandler teamMemberRequestHandler  
@inject IGitHubRequestHandler gitHubRequestHandler 
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<PageTitle>Задача </PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="" Style="height:100%; " Gutters="false">
    @if(error != null)
    {
        <MudAlert Severity=severity>@error</MudAlert>
    }
    else
    {
        @if (User == null || job == null || project == null || teamMembers == null || assignments == null || assignmentsActivities == null || activitiesCommits == null || assignmentsTeamMembers == null || creatorTeamMember == null || creatorTeamMemberGitHubUser == null || assignmentsTeamMemberGitHubUsers == null)
        {
            <LoadingPlaceholder />
        }
        else
        {
            @if (!isTeamMember)
            {
                <UnauthorizedPlaceholder />
            }
            else
            {
               <MudTabs ApplyEffectsToContainer="true" 
                     TabPanelsClass="pa-2 ma-0"
                     Centered="true">
                    @* general *@
                    <MudTabPanel Text="Общее ">
                         <JobDisplay Job="@job"
                                     Creator="@creatorTeamMember"
                                     CreatorGitHubUser="@creatorTeamMemberGitHubUser"/>
                    </MudTabPanel>

                    @* assignments & activities *@
                    <MudTabPanel Text="Исполнители и действия ">
                        @if (assignments.Count() == 0)
                        {
                            <MudAlert Severity="Severity.Info" Class="ma-4">
                                У этой задачи пока нет исполнителей и действий
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var assignment in assignments)
                            {
                                <AssignmentWithActivities Assignment="@assignment"
                                                          Project="@project"
                                                          TeamMember="@assignmentsTeamMembers[assignment.Id]"
                                                          TeamMemberGitHubUser="@assignmentsTeamMemberGitHubUsers[assignment.Id]"
                                                          Activities="@assignmentsActivities[assignment.Id]"
                                                          ActivitiesCommits="activitiesCommits"  
                                                            IsDeletable="false"/> 
                            }
                        }
                    </MudTabPanel>

                    @* staticstics *@
                    <MudTabPanel Text="Статистика ">
                        @if (assignments.Count() == 0)
                        {
                            <MudAlert Severity="Severity.Info" Class="ma-4">
                                У этой задачи пока нет исполнителей, действий, и соответственно, данных для статистики 
                            </MudAlert>
                        }
                        else
                        {
                            <JobStatistics Job="@job"
                                           AssignmentsActivities="@assignmentsActivities" 
                                           AssignmentsTeamMembers="@assignmentsTeamMembers"
                                           AssignmentsTeamMemberGitHubUsers="@assignmentsTeamMemberGitHubUsers" />
                        }
                    </MudTabPanel>
                </MudTabs>   
            }
        }
    }
</MudContainer>


    @code {
    [CascadingParameter]
    private UserDto? User { get; set; }

    [Parameter]
    public Guid jobId { get; set; }

    private JobDisplayDto? job { get; set; } 
    private ProjectDisplayDto? project { get; set; } 
    private IEnumerable<TeamMemberDisplayDto>? teamMembers { get; set; } 
    private IEnumerable<AssignmentDisplayDto>? assignments { get; set; } 
    private ILookup<Guid, ActivityDisplayDto>? assignmentsActivities { get; set; }
    private IDictionary<Guid, GitHubCommitDto>? activitiesCommits { get; set; }
    private IDictionary<Guid, TeamMemberDisplayDto>? assignmentsTeamMembers { get; set; }
    private IDictionary<Guid, GitHubUserDto>? assignmentsTeamMemberGitHubUsers { get; set; } 
    private TeamMemberDisplayDto? creatorTeamMember { get; set; }
    private GitHubUserDto? creatorTeamMemberGitHubUser { get; set; }

    private bool isCreator { get; set; } = false; 
    private bool isTeamMember { get; set; } = false; 

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null)
        {
            try
            {
                await LoadJob();
                await LoadProject(); 
                await LoadTeamMembers(); 
                await LoadAssignments(); 
                await LoadAssignmentsActivities(); 
                await LoadActivitiesCommits(); 
                await LoadAssignmentsTeamMembers(); 
                await LoadAssignmentsTeamMemberGithubUsers();  

                isCreator = (project!.CreatorId == User.Id);
                isTeamMember = teamMembers!.Select(tm => tm.UserId).Contains(User.Id);
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }

        StateHasChanged();
    }

    private async Task LoadJob()
    {
        job = await jobRequestHandler.GetDisplayById(jobId);
    }

    private async Task LoadProject()
    {
        project = await projectRequestHandler.GetById(job!.ProjectId);
    }

    private async Task LoadTeamMembers()
    {
        teamMembers = await teamMemberRequestHandler.GetByProjectId(project!.Id);
    }

    private async Task LoadAssignments()
    {
        assignments = await assignmentRequestHandler.GetByJobId(job!.Id);
    }

    private async Task LoadAssignmentsActivities()
    {
        var activities = await activityRequestHandler.GetByJobId(job!.Id); 

        assignmentsActivities = activities.ToLookup(a => a.AssignmentId); 
    }

    private async Task LoadActivitiesCommits()
    {
        var commits = new List<GitHubCommitDto>();
        var activities = assignmentsActivities!.SelectMany(a => a).ToList(); 

        foreach (var activity in activities)
        {
            if(activity.Commit != null)
            {
                var commit = await gitHubRequestHandler.GetCommitByHash(project!, activity.Commit);     

                commits.Add(commit);
            }
        }

        activitiesCommits = activities.Join(
            commits,
            activity => activity.Commit,  // Key from Activity
            commit => commit.Sha,         // Key from Commit 
            (activity, commit) => new { activity.Id, commit } 
        )
        .ToDictionary(x => x.Id, x => x.commit);
    } 

    private async Task LoadAssignmentsTeamMembers()
    {
        var teamMembers = await teamMemberRequestHandler.GetByProjectId(job!.ProjectId);  

        creatorTeamMember = teamMembers.FirstOrDefault(tm => tm.Id == job!.CreatorId);
        creatorTeamMemberGitHubUser = await gitHubRequestHandler.GetUserByLogin(creatorTeamMember!.UserLogin);

        assignmentsTeamMembers = assignments!.Join(
            teamMembers,
            assignment => assignment.TeamMemberId, 
            teamMember => teamMember.Id, 
            (assignment, teamMember) => new { assignment.Id, teamMember }
        )
        .ToDictionary(x => x.Id, x => x.teamMember);
    }

    private async Task LoadAssignmentsTeamMemberGithubUsers()
    {
        var gitHubUsers = await gitHubRequestHandler.GetUsersByLogins(assignmentsTeamMembers!.Values.Select(tm => tm.UserLogin));

        assignmentsTeamMemberGitHubUsers = assignments!.Join(
           gitHubUsers,
           assignment => assignment.TeamMemberLogin,
           gitHubUser => gitHubUser.Login,
           (assignment, gitHubUser) => new { assignment.Id, gitHubUser}
       )
       .ToDictionary(x => x.Id, x => x.gitHubUser); 
    }
}
