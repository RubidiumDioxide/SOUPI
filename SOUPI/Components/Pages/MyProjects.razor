@page "/myprojects"
@inject NavigationManager NavigationManager 
@inject IUserService UserService 
@inject IProjectService ProjectService  
@inject ISnackbar Snackbar
@inject IHttpContextAccessor HttpContextAccessor 
@using GithubUser = Octokit.User
@using SOUPIShared.Exceptions;
@attribute [Authorize]


<PageTitle>Мои проекты</PageTitle>

<MudContainer Class="pt-14" >
    @if (user == null || projects == null)
    {
        <MudText Align="Align.Center">Loading... </MudText>
    }
    else
    {
        <MudStack AlignItems="AlignItems.Center">
            <MudButton OnClick="NavigateToNewProject">Новый проект</MudButton>

            @if (error == null)
            {
                <MudGrid Class="mt-8">
                    @foreach (ProjectDto project in projects)
                    {
                        <ProjectCard Project=@project
                                     NavigationManager="NavigationManager" />
                    }
                </MudGrid>
            }
            else
            {
                <MudAlert Severity=severity>@error</MudAlert>
            }
        </MudStack>
    }
</MudContainer>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    private string? githubUserLogin { get; set; } 
    private UserDto? user { get; set; } 
    private IEnumerable<ProjectDto>? projects { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState != null)
        {
            var authState = await authenticationState;

            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await LoadUser();
                await LoadProjects(); 
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private async Task LoadUser()
    {
        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            var githubUserLogin = httpContext.User.FindFirst("urn:github:login").Value;

            if (string.IsNullOrEmpty(githubUserLogin))
            {
                throw new SoupiException("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ");
            }

            user = await UserService.GetUserByLogin(githubUserLogin);

            if (user == null)
            {
                throw new SoupiException("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ");
            }
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    } 

    private async Task LoadProjects()
    {
        try
        {
            projects = await ProjectService.GetProjectsByLogin(user!.Login);

            if (projects.Count() == 0)
            {
                error = "Здесь пока ничего нет :( ";
                severity = Severity.Warning; 
            }
            else
            {
                error = null; 
            }

            StateHasChanged(); 
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private void NavigateToNewProject()
    {
        NavigationManager.NavigateTo("/newproject"); 
    }
}