@page "/myprojects"
@inject NavigationManager NavigationManager 
@inject IProjectRequestHandler projectRequestHandler 
@inject IGithubRequestHandler githubRequestHandler 
@inject ISnackbar Snackbar 
@inject IDialogService DialogService 
@attribute [Authorize]


<PageTitle>Мои проекты</PageTitle>

<MudContainer Class="pt-14" MaxWidth=MaxWidth.False>
    <MudStack AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Filled" OnClick="OpenAddDialog">Новый проект</MudButton>

        @if(error != null)
        {
            <MudAlert Severity=severity>@error</MudAlert>
        }
        else
        {
            @if (User == null || GithubUser == null || projects == null)
            {
                <MudText Align="Align.Center">Loading... </MudText>
            }
            else
            {
                <MudGrid Class="mt-8">
                    @foreach (ProjectDto project in projects)
                    {
                        <ProjectCard Project=@project
                                     OnDeleteButtonClick="DeleteProject"
                                     NavigationManager="NavigationManager" />
                    }
                </MudGrid>
            }
        }
    </MudStack>
</MudContainer>


@code {
    [CascadingParameter]
    private UserDto? User { get; set; } 
    [CascadingParameter] 
    private GithubUser? GithubUser { get; set; } 

    private string? error { get; set; } = null;
    private Severity severity { get; set; } = Severity.Warning;

    private IEnumerable<ProjectDto>? projects { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if(User != null && GithubUser != null)
        {
            try
            {
                await LoadProjects(); 
            }
            catch (SoupiException ex)
            {
                error = ex.Message;
                severity = Severity.Error;
            }
            catch (Exception ex)
            {
                error = "Произошла непредвиденная ошибка ";
                severity = Severity.Error;
            }
        }
    }

    private async Task LoadProjects()
    {
        projects = await projectRequestHandler.GetByUserId(User.Id);

        if (projects.Count() == 0)
        {
            error = "Здесь пока ничего нет :( ";
            severity = Severity.Warning;
        }
        else
        {
            error = null;
        }

        StateHasChanged();
    }

    private async Task DeleteProject(ProjectDto projectDto)
    {
        try
        {
            if(projectDto.GithubRepository != null)
            {
                await githubRequestHandler.DeleteHook(User!.Login, projectDto.GithubRepository);    
            }

            await projectRequestHandler.Delete(projectDto.Id); 

            await LoadProjects(); 
            Snackbar.Add("Проект успешно удален ", Severity.Success);
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error); 
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters<NewProjectForm>
        {
            { x => x.User, User },
            { x => x.GithubUser, GithubUser } 
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<NewProjectForm>("Новый проект", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadProjects(); 
            StateHasChanged(); 
        }
    }
}