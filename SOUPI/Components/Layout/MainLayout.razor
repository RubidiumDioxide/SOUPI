@inherits LayoutComponentBase
@inject IUserRequestHandler userRequestHandler 
@inject IGithubRequestHandler githubRequestHandler
@inject ISnackbar Snackbar 
@inject ProtectedSessionStorage SessionStorage


<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider /> 
<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">SOUPI</MudText>
        <MudSpacer />
        <MudSwitch @bind-Value="@_isDarkMode" Color="Color.Primary" Class="ma-4" T="bool" Label="Toggle Light/Dark Mode" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent>
        @if (!_isAuthenticated)
        {
            <MudContainer Class="pt-14">
                <MudStack AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5" Align="Align.Center">Hey there! To use this app, you must first log in using your GitHub account.</MudText>
                    <MudText Typo="Typo.body2">All of your projects and progress will be saved under this GitHub account.</MudText>

                    <MudButton Href="api/Auth/Login" Variant="Variant.Filled" Color="Color.Primary">
                        Log In with GitHub
                    </MudButton>
                </MudStack>
            </MudContainer>
        }
        else if(user == null || githubUser == null)
        {
            <MudContainer Class="pt-14">
                <MudText Align="Align.Center">Loading... </MudText>
            </MudContainer>
        }
        else
        {
            <CascadingValue Value=@user IsFixed=true>
                <CascadingValue Value=@githubUser IsFixed=true>
                    @Body 
                </CascadingValue>
            </CascadingValue>
        }
    </MudMainContent>
</MudLayout> 

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; } 

    private MudThemeProvider _mudThemeProvider;

    private GithubUser? githubUser { get; set; }
    private UserDto? user { get; set; } 
    private bool _isDarkMode; 
    private bool _drawerOpen = false; 
    private bool _isAuthenticated = false; 

    protected override async Task OnInitializedAsync()
    {
        if(authenticationState != null)
        {
            try
            {
                var authState = await authenticationState; 

                if(authState.User.Identity?.IsAuthenticated == true)
                {
                    _isAuthenticated = true; 

                    await LoadGithubUser(); 
                    await LoadUser();

                    StateHasChanged(); 
                }
                else
                {
                    Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
                }
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error); 
            }
            catch (Exception ex)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Ошибка аутентификации. Попробуйте позже или сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender = true)
    {
        var response = await SessionStorage.GetAsync<bool>("isDarkMode");
        if (response.Success)
        {
            _isDarkMode = response.Value;
            return;
        }

        _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
    }

    private async Task LoadGithubUser()
    {
        githubUser = await githubRequestHandler.GetCurrentUser();    
    }

    private async Task LoadUser()
    {
        user = await userRequestHandler.GetByLogin(githubUser.Login);

        if (user == null)
        {
            user = await userRequestHandler.Create(new UserDto()
            {
                Login = githubUser.Login
            });
        }
    }

    private async Task SaveSelectedTheme()
    {
        await SessionStorage.SetAsync("isDarkMode", _isDarkMode);
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}