@inject IAssignmentRequestHandler assignmentRequestHandler 
@inject ISnackbar Snackbar


<MudDialog>
    <TitleContent> 
        <MudText Typo="Typo.h5">Редактирование назначения исполнителя </MudText>           
    </TitleContent>
    <DialogContent>
        @if (Assignment == null || assignmentBackup == null)
        {
            <LoadingPlaceholder/>
        }
        else
        {
            <EditForm Model=@Assignment OnValidSubmit="UpdateAssignment">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value=@Assignment.TeamMemberLogin
                              Variant="Variant.Outlined" 
                              Disabled="true" />
               
                <MudTextField @bind-Value=@Assignment.Comment
                              For="@(() => Assignment.Comment)"
                              Label="Комментарий"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Margin="Margin.Normal" />

                <div class="d-flex justify-end mt-4">
                    <MudButton OnClick="Cancel"
                               Class="mr-2"
                               Disabled="@isProcessing">
                        Отмена
                    </MudButton>
                    <MudButton OnClick="ResetForm"
                               Variant="Variant.Filled"
                               Class="mr-2"
                               Disabled="@isProcessing">
                        Сбросить
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               Disabled="@isProcessing">
                        Сохранить
                    </MudButton>
                </div>
            </EditForm>
        }
    </DialogContent>
</MudDialog>


@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!; 
    [Parameter, EditorRequired]
    public AssignmentDisplayDto? Assignment { get; set; } 

    public AssignmentDto? assignmentBackup { get; set; }

    private bool isProcessing { get; set; } = false; 

    protected override void OnParametersSet()
    {
        if(Assignment != null)
        {
            ResetForm();            
        }
    }

    private void ResetForm()
    {
        if(assignmentBackup != null)
        {
            Assignment!.Comment = assignmentBackup.Comment;     
        }

        assignmentBackup = new AssignmentDto(Assignment!); 

        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task UpdateAssignment()
    {
        try
        {
            if (isProcessing) return;
            isProcessing = true;

            await assignmentRequestHandler.UpdateContent(new AssignmentDto(Assignment!)); 

            ResetForm(); 

            Snackbar.Add("Назначение успешно изменено ", Severity.Success);

            MudDialog.Close(DialogResult.Ok(Assignment)); 

            isProcessing = false; 
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error); 
            isProcessing = false;
        }
        catch(Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);    
            isProcessing = false;
        }
    }
}