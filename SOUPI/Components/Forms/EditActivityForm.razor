@inject IActivityRequestHandler activityRequestHandler 
@inject ISnackbar Snackbar


<MudDialog>
    <TitleContent> 
        <MudText Typo="Typo.h5">Редактирование действия </MudText>           
    </TitleContent>
    <DialogContent>
        @if (Activity == null || activityBackup == null)
        {
            <LoadingPlaceholder/>
        }
        else
        {
            <EditForm Model=@Activity OnValidSubmit="UpdateActivity">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value=@Activity.Commit
                              Variant="Variant.Outlined" 
                              Disabled="true" />
               
                <MudTextField @bind-Value=@Activity.Comment
                              For="@(() => Activity.Comment)"
                              Label="Комментарий"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Margin="Margin.Normal" />

                <div class="d-flex justify-end mt-4">
                    <MudButton OnClick="Cancel"
                               Class="mr-2"
                               Disabled="@isProcessing">
                        Отмена
                    </MudButton>
                    <MudButton OnClick="ResetForm"
                               Variant="Variant.Filled"
                               Class="mr-2"
                               Disabled="@isProcessing">
                        Сбросить
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               Disabled="@isProcessing">
                        Сохранить
                    </MudButton>
                </div>
            </EditForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!; 
    [Parameter, EditorRequired]
    public ActivityDisplayDto? Activity { get; set; } 
   
    public ActivityDto? activityBackup { get; set; }

    private bool isProcessing { get; set; } = false;

    protected override void OnParametersSet()
    {
        if(Activity != null)
        {
            ResetForm();            
        }
    }

    private void ResetForm()
    {
        if(activityBackup != null)
        {
            Activity!.Comment = activityBackup.Comment;     
        }

        activityBackup = new ActivityDto(Activity!); 

        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task UpdateActivity()
    {
        try
        {
            if (isProcessing) return;
            isProcessing = true;

            await activityRequestHandler.UpdateContent(new ActivityDto(Activity!)); 

            ResetForm(); 

            Snackbar.Add("Действие успешно изменено ", Severity.Success);

            MudDialog.Close(DialogResult.Ok(Activity)); 
            
            isProcessing = false;
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error); 
            isProcessing = false;
        }
        catch(Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);    
            isProcessing = false;
        }
    }
}