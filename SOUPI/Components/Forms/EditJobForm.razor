@inject IJobRequestHandler jobRequestHandler; 
@inject ISnackbar Snackbar


@if (Job == null)
{
    <LoadingPlaceholder />
}
else
{
    <MudContainer MaxWidth=MaxWidth.False Gutters="false" >
        <EditForm Model=@Job OnValidSubmit="SaveJob">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value=@Job.Title
                          For="@(() => Job.Title)"
                          Label="Название задачи"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal" 
                          Disabled="!IsContentEditable" />

            <MudTextField @bind-Value=@Job.Body
                          For="@(() => Job.Body)"
                          Label="Описание задачи"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Immediate="true"
                          Margin="Margin.Normal" 
                          Disabled="!IsContentEditable" />

            <div class="d-flex gap-4">
                <MudDatePicker @bind-Date=@startDateTime
                               Label="Дата начала"
                               Variant="Variant.Outlined"
                               MinDate="@((ParentJob != null)? minDateTime : null)"
                               MaxDate="@((ParentJob != null)? maxDateTime : null)"
                               Editable="true" 
                               Disabled="!IsContentEditable" />

                <MudDatePicker @bind-Date=@endDateTime
                               Label="Дата завершения"
                               Variant="Variant.Outlined" 
                               MinDate="@((ParentJob != null)? minDateTime : null)"
                               MaxDate="@((ParentJob != null)? maxDateTime : null)"
                               Editable="true" 
                               Disabled="!IsContentEditable" />
            </div>

            @if (Job.HasChildren)
            {
                <MudText Align="Align.Center">У этой задачи есть дочерние задачи. Ее прогресс будет автоматически приравнен к среднему прогрессу дочерних задач. </MudText>
            }
            else
            {
                <MudSlider @bind-Value="Job.Progress"
                           Min="0" Max="100"
                           Color="Color.Primary"
                           ValueLabel="true" 
                           Disabled="!IsProgressEditable">
                    Прогресс (%)
                </MudSlider>
            }

            <div class="d-flex justify-end mt-4">
                <MudButton OnClick="ResetForm"
                           Variant="Variant.Filled"
                           Class="mr-2"
                           Disabled="@isProcessing">
                    Сбросить
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@isProcessing">
                    Сохранить
                </MudButton>
            </div>
        </EditForm>
    </MudContainer>
}


@code {
    [Parameter, EditorRequired]
    public JobDto? Job { get; set; } 
    [Parameter, EditorRequired] 
    public ProjectDisplayDto? Project { get; set;} 
    [Parameter, EditorRequired]
    public IEnumerable<JobDto>? ProjectJobs { get; set; }
    [Parameter, EditorRequired]
    public EventCallback SelectedJobUpdated { get; set; }
    [Parameter]
    public bool IsContentEditable { get; set; } = false; // content = title/description/dates/etc. progress doesnt count since it's required for completion
    [Parameter]
    public bool IsProgressEditable { get; set; } = false; 
    [Parameter, EditorRequired]
    public JobDto? ParentJob { get; set; }
    [Parameter, EditorRequired]
    public bool IsChildJob { get; set; }

    public JobDto? jobBackup { get; set; } = new(); 
    private DateTime? startDateTime = DateTime.Today;
    private DateTime? endDateTime = DateTime.Today.AddDays(10);

    private DateTime? minDateTime; 
    private DateTime? maxDateTime; 

    private bool isProcessing { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if(Job != null && jobBackup != null)
        {
            jobBackup.CopyContentProperties(Job); 

            startDateTime = Job.StartDateTime.ToDateTime(new TimeOnly(0,0,0)); 
            endDateTime = Job.EndDateTime.ToDateTime(new TimeOnly(0,0,0)); 
            
            if (IsChildJob && ParentJob != null)
            {
                minDateTime = ParentJob.StartDateTime.ToDateTime(new TimeOnly(0, 0, 0));
                maxDateTime = ParentJob.EndDateTime.ToDateTime(new TimeOnly(0, 0, 0));
            }
        }
    }

    private void ResetForm()
    {
        Job!.CopyContentProperties(jobBackup!);

        startDateTime = Job!.StartDateTime.ToDateTime(new TimeOnly(0,0,0));
        endDateTime = Job!.EndDateTime.ToDateTime(new TimeOnly(0, 0, 0));

        StateHasChanged();
    }

    public async Task SaveJob()
    {
        try
        {
            if (isProcessing) return;
            isProcessing = true;

            Job.StartDateTime = DateOnly.FromDateTime(startDateTime ?? default); 
            Job.EndDateTime = DateOnly.FromDateTime(endDateTime ?? default);

            if (Job.EndDateTime <= Job.StartDateTime)
            {
                throw new SoupiException("Дата конце задачи должна быть позже даты начала ");
            }

            if (ProjectJobs.Where(j => j.Id != Job.Id).Select(j => j.Title).Contains(Job.Title.Trim()))
            {
                throw new SoupiException("Задача с таким названием уже существует в рамках этого проекта ");
            }

            await jobRequestHandler.UpdateContent(Job);

            await SelectedJobUpdated.InvokeAsync(); 

            Snackbar.Add("Задача успешно изменена", Severity.Success); 

            isProcessing = false; 
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error); 
            isProcessing = false;
        }
        catch (Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error); 
            isProcessing = false; 
        }
    }
}