@inject IJobRequestHandler jobRequestHandler; 
@inject ISnackbar Snackbar


<MudDialog>
    <TitleContent> 
            <MudText Typo="Typo.h5">@($"Новая {((!IsChildJob)? ("задача ") : ("подзадача "))}")</MudText>           
    </TitleContent>
    <DialogContent>
        @if (User == null || Project == null || ProjectJobs == null || newJob == null)
        {
            <MudText Align="Align.Center">Загрузка...</MudText>
        }
        else
        {
            <EditForm Model=@newJob OnValidSubmit="CreateNewJob">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value=@newJob.Title
                              For="@(() => newJob.Title)"
                              Label="Название задачи"
                              Variant="Variant.Outlined"
                              Margin="Margin.Normal" />

                <MudTextField @bind-Value=@newJob.Body
                              For="@(() => newJob.Body)"
                              Label="Описание задачи"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Margin="Margin.Normal" />

                <div class="d-flex gap-4">
                    <MudDatePicker @bind-Date=@startDateTime 
                                   Label="Дата начала"
                                   Variant="Variant.Outlined"
                                   Editable="true" />

                    <MudDatePicker @bind-Date=@endDateTime 
                                   Label="Дата завершения"
                                   Variant="Variant.Outlined"
                                   Editable="true" />
                </div>

                <MudNumericField @bind-Value=@newJob.Progress
                                 Label="Прогресс (%)"
                                 Variant="Variant.Outlined"
                                 Min="0" Max="100"
                                 Margin="Margin.Normal" />

                <MudSlider @bind-Value="newJob.Progress"
                           Min="0" Max="100"
                           Color="Color.Primary"
                           ValueLabel="true" >
                    Прогресс (%)
                </MudSlider>


                <MudSelect @bind-Value=@newJob.Status
                           Label="Статус"
                           Variant="Variant.Outlined"
                           Margin="Margin.Normal">
                    @foreach (JobStatus item in Enum.GetValues(typeof(JobStatus)))
                    {
                        <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
                    }
                </MudSelect>
                
                <div class="d-flex justify-end mt-4">
                    <MudButton OnClick="Cancel" Class="mr-2">Отмена</MudButton>
                    <MudButton OnClick="ResetForm" Color="Color.Secondary" Variant="Variant.Filled" Class="mr-2">Сбросить</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Создать</MudButton>
                </div>
            </EditForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!; 
    [Parameter, EditorRequired]
    public UserDto? User { get; set; } 
    [Parameter, EditorRequired]
    public ProjectDto? Project { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<JobDto>? ProjectJobs { get; set; } 
    [Parameter, EditorRequired]
    public JobDto? ParentJob { get; set; } 
    [Parameter, EditorRequired]
    public bool IsChildJob { get; set; }

    private JobDto newJob = new JobDto();
    private DateTime? startDateTime { get; set; }
    private DateTime? endDateTime { get; set; }

    protected override void OnParametersSet()
    {
        if (IsChildJob && ParentJob != null)
        {
            startDateTime = ParentJob.StartDateTime; 
            endDateTime = startDateTime.Value.AddDays(10); 
        }
        else
        {
            startDateTime = DateTime.Today;
            endDateTime = DateTime.Today.AddDays(10);
        }

        if(User != null && Project != null)
        {
            ResetForm();       
        }
    }

    private void ResetForm()
    {
        newJob = new JobDto();

        newJob.ProjectId = Project!.Id;
        newJob.CreatorId = User!.Id; 

        if (IsChildJob && ParentJob != null)
        {
            newJob.ParentJobId = ParentJob.Id;
        }

        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task CreateNewJob()
    {
        try
        {
            newJob.StartDateTime = startDateTime ?? default; 
            newJob.EndDateTime = endDateTime ?? default;  

            if(newJob.EndDateTime <= newJob.StartDateTime)
            {
                throw new SoupiException("Дата конце задачи должна быть позже даты начала "); 
            }

            if(ProjectJobs.Select(j => j.Title).Contains(newJob.Title.Trim()))
            {
                throw new SoupiException("Задача с таким названием уже существует в рамках этого проекта "); 
            }

            await jobRequestHandler.Create(newJob); 

            ResetForm(); 

            Snackbar.Add("Задача успешно создана", Severity.Success);

            MudDialog.Close(DialogResult.Ok(newJob));
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch(Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);    
        }
    }
}