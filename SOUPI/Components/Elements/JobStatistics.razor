@inject ISnackbar Snackbar


<MudContainer Gutters="false" Class="pt-14">
    @if (Job == null || AssignmentsTeamMembers == null || AssignmentsActivities == null || AssignmentsTeamMemberGitHubUsers == null)
    {
        <LoadingPlaceholder />
    }
    else
    {
       <MixedChart Labels="@assignmentLabels"
                   DataSet="@activitiesPerAssignmentDataSet" />
    }
</MudContainer>


    @code {
    [Parameter, EditorRequired]
    public JobDisplayDto? Job { get; set; }
    [Parameter, EditorRequired]
    public ILookup<Guid, ActivityDisplayDto>? AssignmentsActivities { get; set; }
    [Parameter, EditorRequired]
    public IDictionary<Guid, TeamMemberDisplayDto>? AssignmentsTeamMembers { get; set; }
    [Parameter, EditorRequired]
    public IDictionary<Guid, GitHubUser>? AssignmentsTeamMemberGitHubUsers { get; set; }

    private Dictionary<ChartType, string> _menuIcons = new()
    {
        { ChartType.Bar, Icons.Material.Filled.BarChart },
        { ChartType.StackedBar, Icons.Material.Filled.StackedBarChart },
        { ChartType.Line, Icons.Material.Filled.ShowChart },
        { ChartType.Pie, Icons.Material.Filled.PieChart },
        { ChartType.Donut, Icons.Material.Filled.DonutLarge },
        { ChartType.Rose, Icons.Material.Filled.DonutSmall },
        { ChartType.Radar, Icons.Material.Filled.Hub },
    };

    private ChartType chartType = ChartType.StackedBar;

    private string[]? assignmentLabels { get; set; }
    private string[]? monthLabels { get; set; }
    private string[]? weekLabels { get; set; }

    // activities per assignment 
    private List<ChartSeries<int>>? activitiesPerAssignmentDataSet { get; set; }
    private List<ChartSeries<int>>? activitiesPerMonthDataSet { get; set; }
    private List<ChartSeries<int>>? activitiesPerWeekDataSet { get; set; }

    protected override async Task OnParametersSetAsync() 
    {
        if (Job != null && AssignmentsTeamMembers != null && AssignmentsActivities != null && AssignmentsTeamMemberGitHubUsers != null)
        {
            try
            {
                assignmentLabels = AssignmentsTeamMemberGitHubUsers.Values.Select(tm => tm.Login).ToArray(); 

                activitiesPerAssignmentDataSet = [
                    new() { 
                        Name = "Кол-во действий по исполнителям ", 
                        Data = new(AssignmentsActivities.Select(a => a.Count()).ToList())       
                    }
                ]; 
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error); 
            }
            catch (Exception)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error); 
            }
        }
    }
}