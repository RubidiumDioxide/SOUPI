<MudContainer MaxWidth="MaxWidth.Medium" Style="height:100%; " >
    @if (User == null || Project == null || Assignment == null || Activities == null || ActivitiesCommits == null || TeamMember == null || TeamMemberGitHubUser == null)
    {
        <LoadingPlaceholder />
    }
    else
    {
        @* general assignment info *@
        <MudContainer Class="ma-0 pa-8">
            <MudStack Row="true"
                      Spacing="2"
                      AlignItems="AlignItems.Center">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <MudImage Src="@TeamMemberGitHubUser.AvatarUrl" Alt=@TeamMember.UserLogin />
                </MudAvatar>
                    
                <MudStack>
                    <MudLink Typo="Typo.body1"
                             Href="@($"/user/{TeamMember.UserId}")">
                        @TeamMember.UserLogin
                    </MudLink>
                        
                    @if (Assignment.Comment != null)
                    {
                        <MudText Typo="Typo.body2">@Assignment.Comment</MudText>
                    }
                </MudStack>
            </MudStack>
        </MudContainer>

        @* activities *@
        @if (Activities.Count() == 0)
        {
            <MudAlert Severity="Severity.Info">Этот исполнитель пока не добавил действий</MudAlert>
        }
        else
        {
            <MudStack Spacing="1">
                @foreach (var context in Activities)
                {
                    <MudPaper Class="pa-2" Elevation="2">
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween" >
                       
                            @if (context.Commit != null)
                            {
                                <MudText Typo="Typo.body2">
                                    Коммит
                                    <MudLink Href="@ActivitiesCommits[context.Id].HtmlUrl"
                                             Target="_blank"
                                             Underline="Underline.Hover">
                                        @context.Commit[..7]
                                    </MudLink>,
                                </MudText>
                            }

                            <MudText Typo="Typo.body2">
                                Комментарий: @context.Comment
                            </MudText>

                            @if (IsDeletable)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick=@(() => DeleteActivity.InvokeAsync(context.Id))
                                               Size="Size.Medium" />
                            }
                        </MudStack>
                        @if (ActivitiesCommits == null)
                        {
                            <LoadingPlaceholder />
                        }
                        else
                        {
                            if (ActivitiesCommits.ContainsKey(context.Id))
                            {
                                <MudDivider />
                                <CommitDiff Commit="@ActivitiesCommits[context.Id]" />
                            }
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    }
</MudContainer>


    @code {
    [CascadingParameter]
    private UserDto? User { get; set; }

    [Parameter, EditorRequired]
    public AssignmentDisplayDto? Assignment { get; set; }
    [Parameter, EditorRequired]
    public ProjectDisplayDto? Project { get; set; }
    [Parameter, EditorRequired] 
    public TeamMemberDisplayDto? TeamMember { get; set; }
    [Parameter, EditorRequired] 
    public GitHubUserDto? TeamMemberGitHubUser { get; set; }
    [Parameter, EditorRequired] 
    public IEnumerable<ActivityDisplayDto>? Activities { get; set; }
    [Parameter, EditorRequired] 
    public IDictionary<Guid, GitHubCommitDto>? ActivitiesCommits { get; set; } 
    [Parameter] 
    public bool IsDeletable { get; set; } = false; 
    [Parameter] 
    public EventCallback<Guid> DeleteActivity { get; set; } 
}
