@inject ISnackbar Snackbar


@if (Project == null || Creator == null)
{
    <LoadingPlaceholder />
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
        <ChangeCreatorForm Creator="@Creator"
                           Project="@Project"
                           AvailibleCreators="@availibleCreators" />





    </MudContainer>
}


@code
{
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GitHubUser? GitHubUser { get; set; }

    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;
    [Parameter, EditorRequired]
    public IEnumerable<TeamMemberDisplayDto>? TeamMembers { get; set; }
    [Parameter, EditorRequired]
    public TeamMemberDisplayDto? Creator { get; set; }

    private IEnumerable<TeamMemberDisplayDto>? availibleCreators { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadAvailibleCreators();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }

    private async Task LoadAvailibleCreators()
    {
        availibleCreators = TeamMembers!.Where(tm => tm.Id != Creator!.Id);

        StateHasChanged();
    }
}