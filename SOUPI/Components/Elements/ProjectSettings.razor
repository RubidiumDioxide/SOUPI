@inject IGitHubRequestHandler gitHubRequestHandler 
@inject ISnackbar Snackbar


@if (Project == null || Creator == null)
{
    <LoadingPlaceholder />
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
        @* general properties edit *@
        <EditProjectForm Project="@Project"
                         ProjectUpdated="ProjectUpdated" />

        <MudDivider Class="mb-4 mt-8"/>
        
        @if (isAppInstalled)
        {
            <LinkGitHubRepositoryForm Project="Project"
                                      ProjectUpdated="ProjectUpdated" />
        }
        else
        {
            <MudText Align="Align.Center" Typo="Typo.body1" Class="mud-text-secondary">
                Привязка репозитория и создание вебхуков недоступно, т.к. вы не установили соответствующее приложение в личном кабинете Github.
                <MudLink Color="Color.Primary"
                         Href="https://github.com/apps/soupigithubapp/installations/new/"
                         EndIcon="@Icons.Custom.Brands.GitHub" 
                         Target="_blank">
                    Установить
                </MudLink>
            </MudText>
        }

        <MudDivider Class="mb-4 mt-8" />

        @* transfer ownership *@
        <ChangeCreatorForm Creator="@Creator"
                           Project="@Project"
                           AvailibleCreators="@availibleCreators" 
                           ProjectUpdated="ProjectUpdated" />

        <MudDivider Class="mb-4 mt-8" />

        @* delete project *@
       <DeleteProjectForm Project="@Project"/>
    </MudContainer>
}


@code
{
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GitHubUserDto? GitHubUser { get; set; }

    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;
    [Parameter, EditorRequired]
    public IEnumerable<TeamMemberDisplayDto>? TeamMembers { get; set; }
    [Parameter, EditorRequired]
    public TeamMemberDisplayDto? Creator { get; set; }
    [Parameter, EditorRequired]
    public EventCallback ProjectUpdated { get; set; }

    public bool isAppInstalled { get; set; }

    private IEnumerable<TeamMemberDisplayDto>? availibleCreators { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if(User != null && GitHubUser != null)
        {
            try
            {
                isAppInstalled = await gitHubRequestHandler.IsAppInstalled();

                await LoadAvailibleCreators();
            }
            catch (SoupiException ex)
            {
                isAppInstalled = false;
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception ex)
            {
                isAppInstalled = false;
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }
    }

    private async Task LoadAvailibleCreators()
    {
        availibleCreators = TeamMembers!.Where(tm => tm.Id != Creator!.Id);

        StateHasChanged();
    }
}