<MudItem xs="12" sm="6" md="4">
    <MudCard Elevation="25"> 
        <MudCardHeader>
            <CardHeaderContent>
                <MudLink Href="@($"/project/{Project.Id}")" Typo="Typo.h6">@Project.Title</MudLink>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo=Typo.body2>@Project.Description</MudText>
            <MudText Typo=Typo.body2>Создано @Project.CreationDateTime </MudText>
        </MudCardContent>
        <MudDivider />
    </MudCard>
</MudItem>


@code {
    [Parameter, EditorRequired]
    public ProjectDisplayDto Project { get; set; } = default!;
}
