@inject NavigationManager NavigationManager; 
@inject ITeamMemberRequestHandler teamMemberRequestHandler; 
@inject IUserRequestHandler userRequestHandler; 
@inject IGitHubRequestHandler gitHubRequestHandler; 
@inject ISnackbar Snackbar 


<MudContainer Gutters="false" MaxWidth="MaxWidth.Medium">
    <MudText Align=Align.Center Typo=Typo.h5 Class="pt-4 pb-8">
        Команда проекта
    </MudText>

    @if (User == null || GitHubUser == null || Project == null || teamMembers == null || teamMemberGitHubUsers == null || creator == null || availibleCreators == null)
    {
        <LoadingPlaceholder />
    }
    else
    {
        <NewTeamMemberForm Project=Project
                           TeamMembers=teamMembers />
        

        <TeamTree TeamMembers=teamMembers
                  Project=Project
                  TeamMemberGitHubUsers=teamMemberGitHubUsers
                  TeamMemberUpdated="ProjectUpdated"/>
    }
</MudContainer>


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GitHubUserDto? GitHubUser { get; set; } 

    [Parameter, EditorRequired]
    public EventCallback ProjectUpdated { get; set; }
    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;

    private IEnumerable<TeamMemberDisplayDto>? teamMembers { get; set; }  
    private TeamMemberDisplayDto? creator { get; set; } 
    private IDictionary<string, GitHubUserDto>? teamMemberGitHubUsers { get; set; }

    private IEnumerable<TeamMemberDisplayDto>? availibleCreators { get; set; }

    private string? error { get; set; } = null; 
    private Severity severity { get; set; } = Severity.Warning; 

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadTeamMembers();
            await LoadTeamMemberGitHubUsers();
            await LoadCreator(); 
            await LoadAvailibleCreators(); 

            //test
            //teamMembers = SOUPIShared.TestData.TeamMembers.testTeamMembers; 
        }
        catch (SoupiException ex)
        {
            error = ex.Message;
            severity = Severity.Error;
        }
        catch (Exception ex)
        {
            error = "Произошла непредвиденная ошибка ";
            severity = Severity.Error;
        }
    }

    private async Task LoadTeamMembers()
    {
        teamMembers = await teamMemberRequestHandler.GetByProjectId(Project.Id);

        StateHasChanged();
    } 

    private async Task LoadTeamMemberGitHubUsers()
    {
        var githubUsers = await gitHubRequestHandler.GetUsersByLogins(teamMembers.Select(tm => tm.UserLogin)); 

        teamMemberGitHubUsers = githubUsers.ToDictionary(gu => gu.Login); 

        StateHasChanged(); 
    }

    private async Task LoadCreator()
    {
        creator = teamMembers.FirstOrDefault(tm => tm.UserId == Project.CreatorId);

        StateHasChanged();
    }

    private async Task LoadAvailibleCreators()
    {
        availibleCreators = teamMembers.Where(tm => tm.Id != creator.Id);

        StateHasChanged();
    }

    public async Task Rerender()
    {
        await LoadTeamMembers();
        await LoadTeamMemberGitHubUsers();
        await LoadCreator();
        await LoadAvailibleCreators();

        StateHasChanged(); 
    }
}