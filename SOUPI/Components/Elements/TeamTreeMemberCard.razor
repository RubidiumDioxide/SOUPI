<MudItem>
    <MudCard Elevation="25">
        <MudCardHeader>
            <CardHeaderContent>
                <MudLink Href="@($"/users/{TeamMember.UserId}")" Typo="Typo.h6">@TeamMember.UserLogin</MudLink>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo=Typo.body2>@((TeamMember.Role != null)? TeamMember.Role : string.Empty)</MudText>
        </MudCardContent>
        <MudDivider />
    </MudCard>
</MudItem>


@code {
    [Parameter, EditorRequired]
    public TeamMemberDisplayDto TeamMember { get; set; } = default!;
}
