@inject IActivityRequestHandler activityRequestHandler 
@inject ISnackbar Snackbar 
@inject IDialogService DialogService 


@if (Job == null || activities == null)
{
    <LoadingPlaceholder />
}
else {
    <MudContainer Class="ma-1 pa-0" MaxWidth="MaxWidth.False" Gutters="false">
        @if (activities.Count() == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                У этой задачи нет действий 
            </MudAlert>
        }
        else
        {
            <MudStack Spacing="1">
                @foreach (var context in activities)
                {
                    <MudPaper Class="pa-2" Elevation="2">
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween">
                            @* Left Side: Avatar and Name/Comment *@
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                                    <MudImage Src="@TeamMemberGitHubUsers[context.TeamMemberLogin].AvatarUrl" Alt=@context.TeamMemberLogin />
                                </MudAvatar>
                        
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">@context.TeamMemberLogin</MudText>
                                    <MudText Typo="Typo.body2">@context.Comment</MudText>
                                </MudStack>
                            </MudStack>

                            @* Right Side: Go to activity button *@
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Color="Color.Success"
                                               Href=@($"/activity/{context.Id}")
                                               Size="Size.Medium" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(async () => await DeleteActivity(context.Id))"
                                               Size="Size.Medium" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </MudContainer>
}


@code {
    [Parameter, EditorRequired]
    public JobDto? Job { get; set; } 
    [Parameter, EditorRequired]
    public IDictionary<string, GitHubUser> TeamMemberGitHubUsers { get; set; } 

    public IEnumerable<ActivityDisplayDto>? activities { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Job != null)
        {
            try
            {
                await LoadActivities(); 
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
            }
        }

        StateHasChanged();
    }

    private async Task LoadActivities()
    {
        activities = await activityRequestHandler.GetByJobId(Job!.Id);  
    }

    private async Task OpenEditDialog(ActivityDisplayDto updatedActivity)
    {
        var parameters = new DialogParameters<EditActivityForm>
        {
            { x => x.Activity, updatedActivity }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<EditAssignmentForm>("Редактирование действия ", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadActivities();

            StateHasChanged();
        }
    }

    private async Task DeleteActivity(Guid activityId)
    {
        try
        {
            await activityRequestHandler.Delete(activityId);

            await LoadActivities();

            Snackbar.Add($"Действие успешно удалено ", Severity.Success);

            StateHasChanged();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }
}
