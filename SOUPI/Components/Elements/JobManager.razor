@if (Job != null)
{
    <MudCard Elevation="4" Class="border-t-4 mud-border-primary">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Editing Task: @Job.name</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" />
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudStack Style="width: 50%">
                <MudTextField @bind-Value="Job.name"
                              Label="Job Name"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudText Typo="Typo.caption" Class="ml-2">Progress: @Job.progress%</MudText>
                <MudSlider @bind-Value="Job.progress"
                           Min="0" Max="100"
                           Color="Color.Primary"
                           ValueLabel="true" />

                <MudDatePicker Label="Start Date"
                               @bind-Date="Job.start"
                               PickerVariant="PickerVariant.Dialog"
                               Variant="Variant.Outlined" />

                <MudDatePicker Label="End Date"
                               @bind-Date="Job.end"
                               PickerVariant="PickerVariant.Dialog"
                               Variant="Variant.Outlined" />


                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary">
                    Done
                </MudButton>
            </MudStack> 
        </MudCardContent>
    </MudCard>
}
else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" ContentAlignment="HorizontalAlignment.Center">
        Click on a task bar in the chart above to edit details.
    </MudAlert>
}


@code {
    [Parameter, EditorRequired]
    public GanttJobDto? Job { get; set; } = new();

    [Parameter]
    public EventCallback<GanttJobDto> JobChanged { get; set; }
}