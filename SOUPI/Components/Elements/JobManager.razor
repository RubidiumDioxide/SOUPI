@if (Job != null)
{
    <MudCard Elevation="4" Class="border-t-4 mud-border-primary">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Editing Task: @Job.name</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" />
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Job.name"
                                  Label="Job Name"
                                  Variant="Variant.Outlined"
                                  Class="mb-4" />

                    <MudText Typo="Typo.caption" Class="ml-2">Progress: @Job.progress%</MudText>
                    <MudSlider @bind-Value="Job.progress"
                               Min="0" Max="100"
                               Color="Color.Primary"
                               ValueLabel="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudDatePicker Label="Start Date"
                                           @bind-Date="Job.start"
                                           PickerVariant="PickerVariant.Dialog"
                                           Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker Label="End Date"
                                           @bind-Date="Job.end"
                                           PickerVariant="PickerVariant.Dialog"
                                           Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                    <div class="d-flex justify-end mt-6">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary">
                            Done
                        </MudButton>
                    </div>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" ContentAlignment="HorizontalAlignment.Center">
        Click on a task bar in the chart above to edit details.
    </MudAlert>
}


@code {
    [Parameter, EditorRequired]
    public GanttJob? Job { get; set; } = new();

    [Parameter]
    public EventCallback<GanttJob> JobChanged { get; set; }
}