@inject ISnackbar Snackbar


<MudContainer Gutters="false" Class="pt-14">
    @if (User == null || Project == null || Jobs == null || Assignments == null || 
         Activities == null || TeamMembers == null || assignmentsPerTeamMemberDataSet == null || 
         activitiesPerTeamMemberDataSet == null || completedToUncompletedJobsPerTeamMemberDataSet == null || 
         createdAndCompletedJobsPerMonthDataSet == null || activitiesPerMonthDataSet == null)
    {
        <LoadingPlaceholder />
    }
    else
    {           
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText>Количество назначений в качестве исполнителя по участникам команды</MudText>
                <MixedChart Labels="@teamMemberLabels"
                            DataSet="@assignmentsPerTeamMemberDataSet" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText>Количество действий по участникам команды</MudText>
                <MixedChart Labels="@teamMemberLabels"
                            DataSet="@activitiesPerTeamMemberDataSet" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText>Выполненные и невыполненные задачи на участника команды</MudText>
                <MixedChart Labels="@teamMemberLabels"
                            DataSet="@completedToUncompletedJobsPerTeamMemberDataSet" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText>Созданные и завершенные задачи по месяцам</MudText>
                <MixedChart Labels="@monthLabels"
                            DataSet="@createdAndCompletedJobsPerMonthDataSet" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText>Количество действий по месяцам</MudText>
                <MixedChart Labels="@monthLabels"
                            DataSet="@activitiesPerMonthDataSet" />
            </MudItem>
        </MudGrid>
    }
</MudContainer>


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }

    [Parameter, EditorRequired]
    public ProjectDisplayDto? Project { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<JobDisplayDto>? Jobs { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<AssignmentDisplayDto>? Assignments { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<ActivityDisplayDto>? Activities { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<TeamMemberDisplayDto>? TeamMembers { get; set; }

    private Dictionary<ChartType, string> _menuIcons = new()
    {
        { ChartType.Bar, Icons.Material.Filled.BarChart },
        { ChartType.StackedBar, Icons.Material.Filled.StackedBarChart },
        { ChartType.Line, Icons.Material.Filled.ShowChart },
        { ChartType.Pie, Icons.Material.Filled.PieChart },
        { ChartType.Donut, Icons.Material.Filled.DonutLarge },
        { ChartType.Rose, Icons.Material.Filled.DonutSmall },
        { ChartType.Radar, Icons.Material.Filled.Hub },
    };

    private ChartType chartType = ChartType.StackedBar;

    private string[]? teamMemberLabels { get; set; }
    private string[]? monthLabels { get; set; }

    // activities per assignment 
    private List<ChartSeries<double>>? assignmentsPerTeamMemberDataSet { get; set; }
    private List<ChartSeries<double>>? activitiesPerTeamMemberDataSet { get; set; }
    private List<ChartSeries<double>>? completedToUncompletedJobsPerTeamMemberDataSet { get; set; }
    private List<ChartSeries<double>>? createdAndCompletedJobsPerMonthDataSet { get; set; } 
    private List<ChartSeries<double>>? activitiesPerMonthDataSet { get; set; }

    protected override async Task OnParametersSetAsync() 
    {
        if (User != null && Project != null && Jobs != null && Assignments != null && Activities != null && TeamMembers != null && 
           (assignmentsPerTeamMemberDataSet == null || activitiesPerTeamMemberDataSet == null || completedToUncompletedJobsPerTeamMemberDataSet == null ||
           createdAndCompletedJobsPerMonthDataSet == null || activitiesPerMonthDataSet == null))
        {
            try
            {
                monthLabels = GetPassedMonths(Project.CreationDateTime); 

                // assignmentsPerTeamMemberDataSet
                var teamMemberAssignments = Assignments.OrderBy(a => a.TeamMemberLogin)
                                                       .ToLookup(a => a.TeamMemberLogin);
                teamMemberLabels = teamMemberAssignments.Select(g => g.Key).ToArray(); 

                assignmentsPerTeamMemberDataSet =
                [
                    new() {
                        Name = "Назначения в качестве исполнителя",
                        Data = new(teamMemberAssignments.Select(g => (double)g.Count()).ToArray())
                    } 
                ]; 

                // activitiesPerTeamMemberDataSet 
                var teamMemberActivities = Activities.OrderBy(a => a.TeamMemberLogin)
                                                     .ToLookup(a => a.TeamMemberLogin); 

                activitiesPerTeamMemberDataSet =
                [
                    new() {
                        Name = "Действия",
                        Data = new(teamMemberActivities.Select(g => (double)g.Count()).ToList())
                    }
                ];


                // completedToUncompletedJobsPerTeamMemberDataSet
                var assignmentsJobsJoined = Assignments.Join(Jobs,
                                                assignment => assignment.JobId,
                                                job => job.Id,
                                                (assignment, job) => new { assignment.TeamMemberLogin, job }
                                            ); 

                var teamMemberCompletedJobs = assignmentsJobsJoined
                                              .Where(x => x.job.Status == JobStatus.Completed)
                                              .OrderBy(x => x.TeamMemberLogin) 
                                              .ToLookup(x => x.TeamMemberLogin);

                var teamMemberUncompletedJobs = assignmentsJobsJoined
                                              .Where(x => x.job.Status != JobStatus.Completed)
                                              .OrderBy(x => x.TeamMemberLogin)
                                              .ToLookup(x => x.TeamMemberLogin);

                completedToUncompletedJobsPerTeamMemberDataSet = 
                [
                    new() {
                        Name = "Не завершенные задачи",
                        Data = new(teamMemberUncompletedJobs.Select(g => (double)g.Count()).ToList())
                    }, 
                    new() {
                        Name = "Завершенные задачи",
                        Data = new(teamMemberCompletedJobs.Select(g => (double)g.Count()).ToList())
                    }
                ];

               
                // createdAndCompletedJobsPerMonthDataSet 
                var createdJobsPerMonth = Jobs.Where(j => j.Status != JobStatus.Completed)
                                      .OrderBy(j => j.CreationDateTime)
                                      .ToLookup(j => j.CreationDateTime.ToString("MMMM yyyy"));

                var completedJobsPerMonth = Jobs.Where(j => j.Status == JobStatus.Completed && j.IsCompleted && j.CompletedDateTime != null)
                                                .OrderBy(j => j.CompletedDateTime)
                                                .ToLookup(j => j.CompletedDateTime.Value.ToString("MMMM yyyy"));

                createdAndCompletedJobsPerMonthDataSet  =
                [
                    new() {
                        Name = "Созданные задачи ",
                        Data = new(createdJobsPerMonth.Select(g => (double)g.Count()).ToList())
                    },
                    new() {
                        Name = "Заершенные задачи ",
                        Data = new(completedJobsPerMonth.Select(g => (double)g.Count()).ToList())
                    }
                ];


                // activitiesPerMonthDataSet 
                var monthActivities = Activities.OrderBy(a => a.CreationDateTime)      
                                                .ToLookup(a => a.CreationDateTime.ToString("MMMM yyyy"));
              
                activitiesPerMonthDataSet =
                [
                    new() {
                        Name = "Действия",
                        Data = new(monthActivities.Select(g => (double)g.Count()).ToList())
                    }
                ];
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error); 
            }
            catch (Exception)
            {
                Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error); 
            }
        }
    }

    public static string[] GetPassedMonths(DateTime start)
    {
        List<string> months = new List<string>();
        var current = DateTime.Now; 

        var iterator = new DateTime(start.Year, start.Month, 1);

        while (iterator < new DateTime(current.Year, current.Month, 1))
        {
            months.Add(iterator.ToString("MMMM yyyy"));
            
            iterator = iterator.AddMonths(1);
        }

        // add current month 
        months.Add(iterator.ToString("MMMM yyyy"));

        return months.ToArray();
    }
}