@inject INotificationRequestHandler requestHandler
@inject ISnackbar Snackbar
@using SOUPIShared.Misc; 
@using static SOUPIShared.TestData.Notifications; 


@if (User == null || GithubUser == null || notifications == null)
{
    <MudText Align="Align.Center">Loading... </MudText>
}
else
{
    <MudMenu Icon=@Icons.Material.Filled.Notifications 
        MaxHeight="300" 
        AnchorOrigin="Origin.BottomCenter" 
        TransformOrigin="Origin.TopCenter" 
        FullWidth="false"
        RelativeWidth="DropdownWidth.Adaptive">
        <MudList T="NotificationDisplayDto">
            @foreach (var notification in notifications)
            {
                <MudListItem Class="pt-0 pb-0 mt-0 mb-0"
                    Text="@(notification.NotificationType switch
                    {
                        NotificationType.Info => $"Сообщение от {notification.SenderLogin} ",
                        NotificationType.Invitation => $"{notification.SenderLogin} приглашает вас принять участие в проекте {notification.ProjectName} "
                    })"
                    SecondaryText=@notification.Message
                    Disabled=@notification.HasBeenViewed
                    IconColor="@(notification.NotificationType switch
                    {
                        NotificationType.Info => Color.Info,
                        NotificationType.Invitation => Color.Success
                    })"
                    Icon="@(notification.NotificationType switch
                    {
                        NotificationType.Info => Icons.Material.Filled.Message,
                        NotificationType.Invitation => Icons.Material.Filled.WavingHand
                    })" /> 

                <MudContainer Class="d-flex justify-end gap-2">
                    @if (notification.NotificationType == NotificationType.Invitation)
                    {
                        <MudIconButton Icon=@Icons.Material.Filled.Check Color="Color.Success">Принять</MudIconButton>
                        <MudIconButton Icon=@Icons.Material.Filled.Close Color="Color.Error">Отклонить</MudIconButton>
                    }
                    <MudButton>Прочитано</MudButton>
                </MudContainer>
            }
        </MudList>
    </MudMenu>
}


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GithubUser? GithubUser { get; set; }

    private IEnumerable<NotificationDisplayDto>? notifications { get; set; } 

    protected override async Task OnParametersSetAsync()
    {
        if (User != null && GithubUser != null)
        {
            try
            {
                //await LoadNotifications(); 
                notifications = testNotifications; 
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error); 
            }
            catch (Exception ex)
            {
                Snackbar.Add("Произошла непредвиденная ошибка ", Severity.Error);
            }
        }
    }

    private async Task LoadNotifications()
    {
        notifications = await requestHandler.GetByReceiverId(User.Id);

        StateHasChanged();
    }
}
