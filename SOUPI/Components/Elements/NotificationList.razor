@inject INotificationRequestHandler requestHandler
@inject ISnackbar Snackbar
@using SOUPIShared.Misc; 
@using static SOUPIShared.TestData.Notifications; 


@if (User == null || GithubUser == null || notifications == null)
{
    <MudText Align="Align.Center">Loading... </MudText>
}
else
{
    <MudMenu Icon=@Icons.Material.Filled.Notifications 
        MaxHeight="300" 
        AnchorOrigin="Origin.BottomCenter" 
        TransformOrigin="Origin.TopCenter" 
        FullWidth="false"
        RelativeWidth="DropdownWidth.Adaptive">
        <ActivatorContent>
            @if (notifications.Any(n => !n.HasBeenViewed))
            {
                <MudBadge Content="notifications.Where(n => !n.HasBeenViewed).Count()" Color="Color.Error" Overlap="true" >
                    <MudIconButton Icon=@Icons.Material.Filled.Notifications OnClick="@(() => _open = !_open)"/>
                </MudBadge>
            }
            else
            {
                <MudIconButton Icon=@Icons.Material.Filled.Notifications OnClick="@(() => _open = !_open)" />
            }
        </ActivatorContent>
        <ChildContent>
            @foreach (var notification in notifications)
            {
                <MudMenuItem AutoClose="false"
                             Disabled=@notification.HasBeenViewed
                             IconColor="@(notification.NotificationType switch
                             {
                                 NotificationType.Info => Color.Info,
                                 NotificationType.Invitation => Color.Success
                             })"
                     Icon="@(notification.NotificationType switch
                     {
                         NotificationType.Info => Icons.Material.Filled.Message,
                         NotificationType.Invitation => Icons.Material.Filled.WavingHand
                     })">
                    <ChildContent>
                        <MudText>
                            @(notification.NotificationType switch
                            {
                                NotificationType.Info => $"Сообщение от {notification.SenderLogin} ",
                                NotificationType.Invitation => $"{notification.SenderLogin} приглашает вас принять участие в проекте {notification.ProjectName} в качестве {notification.Role}"
                            })
                        </MudText>
                        <MudText>
                            @notification.Message
                        </MudText>
                        <MudContainer Class="d-flex justify-end gap-2">
                            @if (!notification.HasBeenViewed)
                            {
                                if (notification.NotificationType == NotificationType.Invitation)
                                {
                                    <button @onclick="(async () => await AcceptInvite(notification.Id))"
                                            class="mud-button mud-button-icon mud-button-text pa-2"
                                            type="button" style="min-width: auto;">
                                        <MudIcon Icon=@Icons.Material.Filled.Check Size="Size.Small" Color=Color.Success/>
                                    </button>
                                    <button @onclick="(async () => await MarkAsViewed(notification.Id))"
                                            class="mud-button mud-button-icon mud-button-text pa-2"
                                            type="button" style="min-width: auto;">
                                        <MudIcon Icon=@Icons.Material.Filled.Close Size="Size.Small" Color=Color.Error/>
                                    </button>
                                }
                                <button @onclick="(async () => await MarkAsViewed(notification.Id))"
                                        @onclick:preventDefault
                                        @onclick:stopPropagation 
                                        class="mud-button mud-button-text pa-2">
                                    Прочитано 
                                </button>
                            }
                        </MudContainer>
                    </ChildContent>
                </MudMenuItem>
            }
        </ChildContent>
    </MudMenu>
}


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }
    [CascadingParameter]
    private GithubUser? GithubUser { get; set; }

    private IEnumerable<NotificationDisplayDto>? notifications { get; set; }

    private bool _open = false; 

    protected override async Task OnParametersSetAsync()
    {
        if (User != null && GithubUser != null)
        {
            try
            {
                await LoadNotifications(); 

                //test 
                //notifications = testNotifications; 
            }
            catch (SoupiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error); 
            }
            catch (Exception ex)
            {
                Snackbar.Add("Произошла непредвиденная ошибка ", Severity.Error);
            }
        }
    }

    private async Task LoadNotifications()
    {
        notifications = await requestHandler.GetByReceiverId(User.Id);
        notifications = notifications.OrderByDescending(n => n.CreationDateTime).ToList(); 

        StateHasChanged();
    }

    private async Task AcceptInvite(Guid notificationId)
    {
        try
        {
            await requestHandler.AcceptInvite(notificationId);
            await LoadNotifications();

            StateHasChanged();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла непредвиденная ошибка ", Severity.Error);
        }
    }

    private async Task MarkAsViewed(Guid notificationId)
    {
        try
        {
            await requestHandler.MarkAsViewed(notificationId);
            await LoadNotifications(); 

            StateHasChanged();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла непредвиденная ошибка ", Severity.Error);
        }
    }
}
