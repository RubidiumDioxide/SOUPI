@if (Job == null || Creator == null || CreatorGitHubUser == null)
{
    <LoadingPlaceholder />
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
        <MudText Align="Align.Center" 
                 Typo="Typo.body2" 
                 Class="mud-text-secondary mb-4 mt-4">
            Эта страница служит для простого просмотра и навигации по задачам и исполнителям. Чтобы редактировать совйства задачи, а также связи между задачами, перейдите на страницу
            <MudButton Href="@($"/gantt/{Job.ProjectId}")"
                       Color="Color.Success" 
                       Size="Size.Small">
                Диаграмма Ганта 
            </MudButton>
            .
        </MudText>

        @* Header Section *@
        <div class="d-flex justify-space-between align-start mb-4">
            <MudText Typo="Typo.h4" Class="mr-4">@Job.Title</MudText>
            
            <div class="d-flex align-center">
                <MudChip T="string"
                         Color="@Job.Status.GetStatusColor()"
                         Variant="Variant.Filled"
                         Size="Size.Small"
                         Class="mt-1">
                    @Job.Status.TranslateStatus()
                </MudChip>
            </div>
        </div>

        @* Description *@
        <MudText Typo="Typo.h6">Описание задачи</MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
            @(string.IsNullOrWhiteSpace(Job.Body) ? "Описание отсутствует" : Job.Body)
        </MudText>

        <MudDivider Class="mb-6" />

        <MudStack>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                @* Project Info *@
                <MudStack>
                    <MudText Typo="Typo.h6" Class="mud-text-secondary">Проект</MudText>
                    <MudLink Typo="Typo.body1"
                             Href="@($"/project/{Job.ProjectId}")">
                        @Job.ProjectTitle
                    </MudLink> 
                </MudStack>
        
                @* Creator Info *@
                <MudStack>
                    <MudText Typo="Typo.h6" Class="mud-text-secondary">Создатель</MudText>
                    <div class="d-flex align-center">
                        <MudStack Row="true"
                                  Spacing="2"
                                  AlignItems="AlignItems.Center">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                                <MudImage Src="@CreatorGitHubUser.AvatarUrl" Alt=@Creator.UserLogin />
                            </MudAvatar>
                  
                            <MudLink Typo="Typo.body1"
                                     Href="@($"/user/{Creator.UserId}")">
                                @Creator.UserLogin
                            </MudLink>
                            <MudIconButton Color="Color.Primary" 
                                           Icon=@Icons.Custom.Brands.GitHub 
                                           Size="Size.Small"
                                           Href="@CreatorGitHubUser.HtmlUrl"/>
                        </MudStack>
                    </div>
                </MudStack>
            </MudStack>

            @* Progress *@
            <div class="d-flex justify-space-between mb-1">
                <MudText Typo="Typo.h6" Class="mud-text-secondary">Прогресс выполнения</MudText>
                <MudText Typo="Typo.caption"><b>@Job.Progress%</b></MudText>
            </div>
            <MudProgressLinear Color="Color.Primary" Value="@Job.Progress" Height="10" Class="rounded-sm" />

            @* Dates Section *@
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudStack>
                    <MudText Typo="Typo.h6" Class="mud-text-secondary">Дата создания</MudText>
                    <MudText Typo="Typo.body1">@Job.CreationDateTime.ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudStack>

                <MudStack>
                    <MudText Typo="Typo.h6" Class="mud-text-secondary">Начало</MudText>
                    <MudText Typo="Typo.body1">@Job.StartDateTime.ToString("dd.MM.yyyy")</MudText>
                </MudStack>

                <MudStack>
                    <MudText Typo="Typo.h6" Class="mud-text-secondary">Завершение</MudText>
                    <MudText Typo="Typo.body1">@Job.EndDateTime.ToString("dd.MM.yyyy")</MudText>
                </MudStack>
            </MudStack>
        </MudStack>
    </MudContainer>
}


@code {
    [Parameter, EditorRequired]
    public JobDisplayDto? Job { get; set; }
    [Parameter, EditorRequired]
    public TeamMemberDisplayDto? Creator { get; set; }
    [Parameter, EditorRequired]
    public GitHubUserDto? CreatorGitHubUser { get; set; }
}