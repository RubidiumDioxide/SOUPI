@inject NavigationManager NavigationManager; 
@inject ITeamMemberRequestHandler teamMemberRequestHandler;
@inject ISnackbar Snackbar
@inject IDialogService DialogService


@if (User == null || Project == null || TeamMembers == null || TeamMember == null || TeamMemberGitHubUser == null)
{
    <LoadingPlaceholder />
}
else 
{
    <MudPaper>
        <MudStack Spacing="4" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudAvatar Size=Size.Large>
                        <MudImage Src="@TeamMemberGitHubUser.AvatarUrl" Alt="@TeamMember.UserLogin" />
                    </MudAvatar>
           
                    <MudLink Href="@($"/user/{TeamMember.UserId}")">
                        @TeamMember.UserLogin
                    </MudLink>
            
                    <MudIconButton Color="Color.Primary"
                                   Icon=@Icons.Custom.Brands.GitHub
                                   Size="Size.Small"
                                   Href="@TeamMemberGitHubUser.HtmlUrl"
                                   Target="_blank" />
                </MudStack>

                <div>
                    <MudIconButton OnClick="OpenEditDialog"  
                                   Icon="@Icons.Material.Filled.Edit"
                                   Variant="Variant.Text">
                        Редактировать
                    </MudIconButton>
         
                    @if (TeamMember.UserId != Project.CreatorId)
                    {
                        <MudIconButton OnClick="OpenDeleteDialog"
                                       Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" 
                                       Variant="Variant.Text">
                            Исключить
                        </MudIconButton>
                    }
                </div>
            </MudStack>
        
            @if (TeamMember.Role != null)
            {
                <MudText Typo="Typo.body1">Роль: @TeamMember.Role</MudText>
            }

            @if (TeamMember.SupervisorId != null)
            {
                <MudText Typo="Typo.body1">Руководитель : @TeamMember.SupervisorLogin</MudText>
            }
        </MudStack>
    </MudPaper> 
}


@code {
    [CascadingParameter]
    private UserDto? User { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<TeamMemberDisplayDto> TeamMembers { get; set; } = default!;
    [Parameter, EditorRequired]
    public ProjectDisplayDto Project { get; set; } = default!;
    [Parameter, EditorRequired]
    public TeamMemberDisplayDto TeamMember { get; set; }
    [Parameter, EditorRequired]
    public GitHubUserDto TeamMemberGitHubUser { get; set; } 
    [Parameter, EditorRequired]
    public EventCallback TeamMemberUpdated { get; set; } 

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters<EditTeamMemberForm>
        {
            { x => x.TeamMember, TeamMember }, 
            { x => x.TeamMembers, TeamMembers }, 
            { x => x.Project, Project }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<EditTeamMemberForm>("Редактирование участника команды ", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await TeamMemberUpdated.InvokeAsync(); 

            StateHasChanged();
        }
    }

    private async Task OpenDeleteDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.Title, "Исключение участника проекта "},
            { x => x.Message, "Этот участник будет исключен из команды проекта. Его действия и назначения его в качестве исполнителя будут удалены. Исключение не повлияет на остальные данные проекта" },
            { x => x.ConfirmationText, "Удалить" },
            { x => x.ConfirmationColor, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("SimpleDialog", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await Delete();
        }
    }

    private async Task Delete()
    {
        try
        {
            await teamMemberRequestHandler.Delete(TeamMember.Id); 

            await TeamMemberUpdated.InvokeAsync(); 

            Snackbar.Add($"Пользователь успешно исключен из команды ", Severity.Success);

            StateHasChanged();
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Произошла неожиданная ошибка. Пожалуйста, сообщите об ошибке в техподдержку ", Severity.Error);
        }
    }
}
