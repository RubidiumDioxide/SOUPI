@inject ISnackbar Snackbar


@if (Project == null || TeamMembers == null || TeamMemberGitHubUsers == null || treeTeamMembers == null)
{
    <LoadingPlaceholder />
}
else
{
    <MudContainer Gutters="false" Style="display:flex; flex-direction:row; flex-wrap: nowrap" Class="ma-0 pa-2" MaxWidth="MaxWidth.False">
        <MudContainer MaxWidth=MaxWidth.False Style="width: 50%">
            <MudCard Elevation="25">
                <MudTreeView Items="@treeTeamMembers" @bind-SelectedValue="selectedTeamMember">
                    <ItemTemplate>
                        @{
                            var teamMember = context.Value;
                        }
                        <MudTreeViewItem @bind-Expanded="@context.Expanded"
                        Items="@context.Children"
                        Value="@context.Value"
                        Icon="@context.Icon"
                        Text="@context.Value?.UserLogin">
                            <Content>
                                <MudTreeViewItemToggleButton @bind-Expanded="@context.Expanded" Visible="@context.HasChildren" />
                                <MudText>@($"{teamMember?.UserLogin} ({((teamMember?.Role != null) ? teamMember.Role : string.Empty)})")</MudText>
                            </Content>
                        </MudTreeViewItem>
                    </ItemTemplate>
                </MudTreeView>
            </MudCard>
        </MudContainer>

        <MudContainer MaxWidth=MaxWidth.False Style="width: 50%">
            @if (selectedTeamMember != null)
            {
                <TeamMemberCard TeamMembers=TeamMembers
                                Project=Project
                                TeamMember=selectedTeamMember
                                TeamMemberGitHubUser=@((selectedTeamMember != null)? TeamMemberGitHubUsers[selectedTeamMember.UserLogin] : null) 
                                TeamMemberUpdated="TeamMemberUpdated"/>
            }
        </MudContainer>
    </MudContainer>
}


@code {
    [Parameter, EditorRequired]
    public EventCallback TeamMemberUpdated { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<TeamMemberDisplayDto> TeamMembers { get; set; }
    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;
    [Parameter, EditorRequired]
    public IDictionary<string, GitHubUserDto> TeamMemberGitHubUsers { get; set; }

    private List<TreeItemData<TeamMemberDisplayDto>>? treeTeamMembers { get; set; }
    private TeamMemberDisplayDto? selectedTeamMember { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadTreeTeamMembers();
            
            selectedTeamMember = null; 
        }
        catch (SoupiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Произошла непредвиденная ошибка ", Severity.Error);
        }
    }

    private async Task LoadTreeTeamMembers()
    {
        treeTeamMembers = TeamMembers.BuildTreeItemData();

        StateHasChanged();
    } 
}
